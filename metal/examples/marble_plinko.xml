<mujoco model="marble_plinko">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="Euler" iterations="200" tolerance="1e-8" gravity="0 0 -9.81" cone="pyramidal"/>
  <asset>
    <texture name="floor_grid" type="2d" builtin="checker" rgb1="0.12 0.15 0.20" rgb2="0.22 0.28 0.35" width="512" height="512"/>
    <material name="floor_material" texture="floor_grid" texrepeat="8 8" reflectance="0.1"/>
  </asset>
  <!-- R08/F2 capacity demo: 25 static box pegs + 1 marble = 25 candidate
       pairs / 25 slots, exceeding the old 16-pair / 24-slot ceilings with
       rows (81) inside the 96-row budget. The floor plane is decorative
       (contype 0, like the pinball walls): the ball never descends near
       it in 600 steps, guarded by the min_ball_z gate below. 16 pegs
       carry friction (condim 3), 9 are frictionless (condim 1); the marble
       is condim 1. Static-static peg pairs take no slots (same-weld
       exclusion). -->
  <worldbody>
    <light directional="true" pos="0 -2 5" dir="0 0.3 -1" diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3"/>
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0" material="floor_material" contype="0" conaffinity="0"/>
    <geom name="peg0" type="box" size="0.02 0.02 0.02" pos="-0.6 0 0.9" condim="3"/>
    <geom name="peg1" type="box" size="0.02 0.02 0.02" pos="-0.45 0 0.9" condim="3"/>
    <geom name="peg2" type="box" size="0.02 0.02 0.02" pos="-0.3 0 0.9" condim="3"/>
