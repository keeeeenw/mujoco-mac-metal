    <geom name="peg4" type="box" size="0.02 0.02 0.02" pos="0 0 0.9" condim="3"/>
    <geom name="peg5" type="box" size="0.02 0.02 0.02" pos="0.15 0 0.9" condim="3"/>
    <geom name="peg6" type="box" size="0.02 0.02 0.02" pos="0.3 0 0.9" condim="3"/>
    <geom name="peg7" type="box" size="0.02 0.02 0.02" pos="-0.6 0 0.78" condim="3"/>
