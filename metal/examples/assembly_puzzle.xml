<mujoco model="assembly_puzzle">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="Euler" iterations="1000" tolerance="1e-6" gravity="0 0 -9.81" o_solref="0.006 1" o_solimp="0.9 0.95 0.001 0.5 2"/>
  <asset>
    <texture name="floor_grid" type="2d" builtin="checker" rgb1="0.12 0.15 0.20" rgb2="0.22 0.28 0.35" width="512" height="512"/>
    <material name="floor_material" texture="floor_grid" texrepeat="8 8" reflectance="0.1"/>
    <mesh name="tetra" vertex="0 0 0  0.06 0 0  0 0.06 0  0 0 0.06"/>
    <mesh name="brick" vertex="-0.05 -0.025 -0.0125  0.05 -0.025 -0.0125  0.05 0.025 -0.0125  -0.05 0.025 -0.0125  -0.05 -0.025 0.0125  0.05 -0.025 0.0125  0.05 0.025 0.0125  -0.05 0.025 0.0125"/>
    <mesh name="octa" vertex="0.05 0 0  -0.05 0 0  0 0.05 0  0 -0.05 0  0 0 0.025  0 0 -0.025"/>
  </asset>
  <worldbody>
    <light directional="true" pos="0 -2 5" dir="0 0.3 -1" diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3"/>
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0" material="floor_material" contype="0" conaffinity="0"/>
    <!-- Tray: floor slab, two end walls, one divider making two lanes
         (contains lateral scoot from single-point face contacts). -->
    <body name="tray" pos="0 0 0">
      <geom name="trayfloor" type="box" size="0.25 0.2 0.02" pos="0 0 0.02" rgba="0.1 0.7 0.2 1" mass="0" contype="1" conaffinity="1" condim="3"/>
      <geom name="wallL" type="box" size="0.02 0.2 0.1" pos="-0.26 0 0.1" rgba="0.1 0.6 0.2 1" mass="0" contype="1" conaffinity="1" condim="3"/>
      <geom name="wallR" type="box" size="0.02 0.2 0.1" pos="0.26 0 0.1" rgba="0.1 0.6 0.2 1" mass="0" contype="1" conaffinity="1" condim="3"/>
      <geom name="divider" type="box" size="0.015 0.2 0.08" pos="0.02 0 0.08" rgba="0.1 0.6 0.2 1" mass="0" contype="1" conaffinity="1" condim="3"/>
    </body>
    <body name="pieceA" pos="-0.13 0 0.09">
      <freejoint name="freeA"/>
      <geom name="tetra_geom" type="mesh" mesh="tetra" rgba="0.9 0.1 0.1 1" mass="0.2" friction="0.6 0.05 0.02" contype="1" conaffinity="1" condim="3"/>
    </body>
    <body name="pieceB" pos="0.13 0.05 0.1">
      <freejoint name="freeB"/>
      <geom name="brick_geom" type="mesh" mesh="brick" rgba="0.2 0.5 0.9 1" mass="0.3" friction="0.6 0.05 0.02" contype="1" conaffinity="1" condim="3"/>
    </body>
    <body name="pieceC" pos="0.13 -0.06 0.12">
      <freejoint name="freeC"/>
      <geom name="octa_geom" type="mesh" mesh="octa" rgba="0.9 0.7 0.1 1" mass="0.15" friction="0.6 0.05 0.02" contype="1" conaffinity="1" condim="3"/>
    </body>
  </worldbody>
  <contact>
    <pair geom1="tetra_geom" geom2="trayfloor"/>
    <pair geom1="tetra_geom" geom2="wallL"/>
    <pair geom1="tetra_geom" geom2="divider"/>
    <pair geom1="brick_geom" geom2="trayfloor"/>
    <pair geom1="brick_geom" geom2="wallR"/>
    <pair geom1="brick_geom" geom2="divider"/>
    <pair geom1="octa_geom" geom2="trayfloor"/>
    <pair geom1="octa_geom" geom2="wallR"/>
    <pair geom1="octa_geom" geom2="divider"/>
    <pair geom1="tetra_geom" geom2="brick_geom"/>
    <pair geom1="tetra_geom" geom2="octa_geom"/>
    <pair geom1="brick_geom" geom2="octa_geom"/>
  </contact>
</mujoco>
