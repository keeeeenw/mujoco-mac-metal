<mujoco model="deformable_cable_cradle">
  <option timestep="0.005" iterations="50" solver="PGS"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4"/>
    <material name="grid" texture="grid" texrepeat="2 2" texuniform="true" reflectance="0.2"/>
    <material name="cable_mat" rgba="0.85 0.35 0.15 1" specular="0.5" shininess="0.8"/>
    <material name="bob_mat" rgba="0.2 0.7 0.9 1" specular="0.7" shininess="0.9"/>
    <material name="frame_mat" rgba="0.4 0.4 0.45 1" reflectance="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="1.5 1.5 0.1" material="grid"/>

    <!-- Support frame gantry -->
    <body name="gantry" pos="0 0 1.2">
      <geom type="cylinder" size="0.04 0.02" material="frame_mat"/>
      <geom type="capsule" fromto="-0.3 0 0 0.3 0 0" size="0.015" material="frame_mat"/>

      <!-- Native deformable 1D cable flexcomp -->
      <flexcomp name="cable" type="grid" count="6 1 1" spacing="0.08 0.08 0.08" mass="0.3" radius="0.012" dim="1" material="cable_mat">
        <pin id="0"/>
        <edge equality="true" solref="0.02 1.0" solimp="0.9 0.95 0.001 0.5 2"/>
        <contact contype="0" conaffinity="0"/>
      </flexcomp>
    </body>
  </worldbody>
</mujoco>
