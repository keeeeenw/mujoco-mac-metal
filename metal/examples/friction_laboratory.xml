<mujoco model="friction laboratory">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="Euler"
    cone="pyramidal" iterations="100" tolerance="1e-10"/>
  <asset>
    <texture name="laboratory_checker" type="2d" builtin="checker"
      width="512" height="512" rgb1="0.10 0.19 0.25" rgb2="0.28 0.41 0.47"/>
    <material name="laboratory_floor" texture="laboratory_checker"
      texrepeat="12 12" texuniform="true" reflectance="0.04"/>
  </asset>
  <default>
    <geom condim="3" solref="0.02 1" solimp="0.9 0.95 0.001 0.5 2"
      friction="0.4 0.01 0.01"/>
    <joint damping="0" armature="0"/>
  </default>
  <worldbody>
    <light name="key" directional="true" pos="0 0 4" dir="-0.15 0 -1"
      diffuse="1 1 1" specular="0.3 0.3 0.3"/>
    <geom name="laboratory_floor" type="plane" size="20 20 0.1"
      material="laboratory_floor" contype="1" conaffinity="2"
      rgba="0.88 0.93 0.96 1" friction="0.01 0.01 0.01"/>
    <body name="low_friction" pos="-0.72 0 0.118">
      <freejoint/>
      <geom name="low_friction_ball" type="sphere" size="0.12" mass="0.3"
        friction="0.01 0.01 0.01" contype="2" conaffinity="3"
        rgba="0.95 0.31 0.19 1"/>
    </body>
    <body name="medium_friction" pos="0 0 0.118">
      <freejoint/>
      <geom name="medium_friction_ball" type="sphere" size="0.12" mass="0.3"
        friction="0.12 0.01 0.01" contype="2" conaffinity="3"
        rgba="0.98 0.72 0.24 1"/>
    </body>
    <body name="high_friction" pos="0.72 0 0.118">
      <freejoint/>
      <geom name="high_friction_ball" type="sphere" size="0.12" mass="0.3"
        friction="1.0 0.01 0.01" contype="2" conaffinity="3"
        rgba="0.24 0.62 0.87 1"/>
    </body>
  </worldbody>
</mujoco>
