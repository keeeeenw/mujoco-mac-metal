<mujoco model="cargo_bridge">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="Euler" iterations="1000" tolerance="1e-6" gravity="0 0 -9.81">
    <flag contact="enable" equality="enable" limit="disable" frictionloss="disable"/>
  </option>
  <asset>
    <texture name="floor_grid" type="2d" builtin="checker" rgb1="0.12 0.15 0.20" rgb2="0.22 0.28 0.35" width="512" height="512"/>
    <material name="floor_material" texture="floor_grid" texrepeat="8 8" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light directional="true" pos="0 -2 5" dir="0 0.3 -1" diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3"/>

    <geom material="floor_material" name="floor" type="plane" size="5 5 0.1" pos="0 0 0" condim="3"/>
    <body name="frame" pos="0 0 0">
      <geom name="tray" type="box" size="0.18 0.25 0.05" pos="0.8 0 0.1" rgba="0.1 0.7 0.2 1" mass="0" contype="1" conaffinity="0"/>
    </body>
    <body name="deckA" pos="-0.5 0 0.5">
      <joint name="deckA_hinge" type="hinge" pos="-1.0 0 0.5" axis="0 1 0"/>
      <geom name="deckA_geom" type="box" size="0.5 0.2 0.025" rgba="0.9 0.5 0.1 1" mass="2" friction="0.25 0.05 0.02" contype="1" conaffinity="0" condim="3"/>
    </body>
    <body name="deckB" pos="0.5 0 0.5">
      <freejoint name="deckB_free"/>
      <geom name="deckB_geom" type="box" size="0.5 0.2 0.025" rgba="0.85 0.55 0.15 1" mass="8" friction="0.25 0.05 0.02" contype="1" conaffinity="0" condim="3"/>
    </body>
    <body name="payload" pos="0.7 0 0.6">
      <freejoint name="payload_free"/>
      <geom name="payload_geom" type="sphere" size="0.08" rgba="0.9 0.1 0.1 1" mass="0.5" friction="0.25 0.05 0.02" contype="1" conaffinity="1" condim="3"/>
    </body>
  </worldbody>
  <contact>
    <pair geom1="deckB_geom" geom2="tray" solref="0.006 1" solimp="0.99 0.999 0.001"/>
    <pair geom1="payload_geom" geom2="deckA_geom"/>
    <pair geom1="payload_geom" geom2="deckB_geom"/>
    <pair geom1="payload_geom" geom2="tray"/>
  </contact>
  <equality>
    <connect name="deck_link" body1="deckA" body2="deckB" anchor="0.5 0 0"/>
    <weld name="brace_latch" body1="deckB"/>
  </equality>
</mujoco>
