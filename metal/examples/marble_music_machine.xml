<mujoco model="robotic_marble_music_machine">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="Euler" iterations="1000" tolerance="1e-6" density="1.2" viscosity="0.00002">
    <flag contact="enable" equality="enable" limit="enable" frictionloss="enable"/>
  </option>

  <asset>
    <texture name="checker" type="2d" builtin="checker" width="512" height="512"
      rgb1="0.12 0.15 0.20" rgb2="0.22 0.28 0.35"/>
    <material name="track_mat" texture="checker" texrepeat="8 8" reflectance="0.1"/>
    <material name="paddle_mat" rgba="0.95 0.65 0.15 1" specular="0.8" shininess="0.5"/>
    <material name="chime_mat" rgba="0.25 0.85 0.75 1" specular="0.9" shininess="0.8"/>
    <material name="marble1_mat" rgba="0.90 0.20 0.25 1" specular="0.9" shininess="0.9"/>
    <material name="marble2_mat" rgba="0.20 0.55 0.95 1" specular="0.9" shininess="0.9"/>
  </asset>

  <default>
    <geom condim="3" friction="0.25 0.05 0.05" solref="0.015 1.0" solimp="0.9 0.95 0.001 0.5 2"/>
  </default>

  <worldbody>
    <light directional="true" pos="0 -2 5" dir="0 0.3 -1" diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3"/>
    
    <!-- Floor / catch basin (decorative boundary) -->
    <geom name="floor" type="plane" size="3 3 0.1" pos="0 0 -0.2" material="track_mat"
      contype="0" conaffinity="0"/>

    <!-- Tilted soundboard track / ramp guiding deflected marbles into chime resonators -->
    <geom name="track" type="plane" size="1.5 1.5 0.05" pos="0 0 0.1"
      quat="0.98480775 0 0.17364818 0" material="track_mat"
      contype="1" conaffinity="0"/>

    <!-- Robotic Selector Gate / Paddle 1 (Motorized, with offset paddle arm sweeping 3D arc) -->
    <body name="gate1" pos="0.2 -0.15 0.6">
      <joint name="gate1_hinge" type="hinge" axis="0 1 0" range="-0.6 0.6" limited="true" frictionloss="0.03" damping="0.06"/>
      <geom name="gate1_bar" type="sphere" size="0.06" pos="0.08 0 0" material="paddle_mat" mass="0.3"
        contype="4" conaffinity="0"/>
    </body>

    <!-- Linked Follower Gate 2 (Constrained by joint equality, with offset paddle arm) -->
    <body name="gate2" pos="0.2 0.15 0.6">
      <joint name="gate2_hinge" type="hinge" axis="0 1 0" range="-0.6 0.6" limited="true" frictionloss="0.03" damping="0.06"/>
      <geom name="gate2_bar" type="sphere" size="0.06" pos="0.08 0 0" material="paddle_mat" mass="0.3"
        contype="4" conaffinity="0"/>
    </body>

    <!-- Tuned Chime Bar / Resonator 1 (Spring/Damper Passive dynamics with offset clapper) -->
    <body name="chime1" pos="-0.05 -0.15 0.25">
      <joint name="chime1_hinge" type="hinge" axis="0 1 0" range="-0.6 0.6" limited="true"
        stiffness="35.0" damping="0.15" springref="0.0"/>
      <geom name="chime1_sphere" type="sphere" size="0.06" pos="0.06 0 0.02" material="chime_mat" mass="0.25"
        contype="4" conaffinity="0"/>
    </body>

    <!-- Tuned Chime Bar / Resonator 2 (Higher pitch, stiffer spring with offset clapper) -->
    <body name="chime2" pos="-0.05 0.15 0.25">
      <joint name="chime2_hinge" type="hinge" axis="0 1 0" range="-0.6 0.6" limited="true"
        stiffness="55.0" damping="0.20" springref="0.0"/>
      <geom name="chime2_sphere" type="sphere" size="0.06" pos="0.06 0 0.02" material="chime_mat" mass="0.25"
        contype="4" conaffinity="0"/>
    </body>

    <!-- Red Marble 1 -->
    <body name="marble1" pos="0.26 -0.15 0.85">
      <freejoint name="marble1_free"/>
      <geom name="marble1_sphere" type="sphere" size="0.05" mass="0.25" material="marble1_mat"
        contype="2" conaffinity="7"/>
    </body>

    <!-- Blue Marble 2 -->
    <body name="marble2" pos="0.26 0.15 0.95">
      <freejoint name="marble2_free"/>
      <geom name="marble2_sphere" type="sphere" size="0.05" mass="0.25" material="marble2_mat"
        contype="2" conaffinity="7"/>
    </body>
  </worldbody>

  <equality>
    <!-- Symmetrical counter-rotating dual gate mechanism -->
    <joint joint1="gate2_hinge" joint2="gate1_hinge" polycoef="0 -1.0 0 0 0"/>
  </equality>

  <tendon>
    <!-- Fixed tendon drive coupling gate 1 to chime 1 for rhythmic modulation -->
    <fixed name="gate_tendon" stiffness="6.0" damping="0.05" armature="0.005">
      <joint joint="gate1_hinge" coef="0.4"/>
      <joint joint="chime1_hinge" coef="0.2"/>
    </fixed>
  </tendon>

  <actuator>
    <!-- Rhythmic servo/motor actuating the primary selector gate -->
    <motor name="gate_motor" joint="gate1_hinge" ctrlrange="-2 2"/>
  </actuator>

  <sensor>
    <jointpos joint="gate1_hinge" name="gate_angle"/>
    <jointvel joint="gate1_hinge" name="gate_vel"/>
    <jointpos joint="chime1_hinge" name="chime1_displacement"/>
    <jointpos joint="chime2_hinge" name="chime2_displacement"/>
  </sensor>
</mujoco>
