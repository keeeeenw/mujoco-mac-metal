<mujoco model="cable_drawbridge">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="Euler" iterations="1000" tolerance="1e-6" gravity="0 0 -9.81">
    <flag contact="enable" equality="enable" limit="enable" frictionloss="disable"/>
  </option>
  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0" condim="1" priority="1" contype="1" conaffinity="0"/>
    <body name="tower" pos="-0.8 0 0">
      <geom name="tower_geom" type="box" size="0.08 0.08 0.7" pos="0 0 0.7" rgba="0.5 0.5 0.55 1" mass="0" contype="1" conaffinity="0" condim="3"/>
      <site name="pulley_top" pos="0 0 1.32"/>
      <site name="mid" pos="0.15 0 0.9"/>
      <site name="anchor" pos="0 0 1.38"/>
    </body>
    <body name="bollard" pos="-0.5 0 0">
      <geom name="bollard_geom" type="cylinder" size="0.06 0.15" pos="0 0 0.6" rgba="0.6 0.4 0.2 1" mass="0" contype="1" conaffinity="0" condim="3"/>
    </body>
    <body name="counterweight" pos="-0.2 0 0.35">
      <joint name="winch" type="slide" axis="0 0 1" limited="true" range="0.02 0.65" damping="0.5"/>
      <geom name="weight_geom" type="box" size="0.09 0.09 0.09" rgba="0.3 0.3 0.35 1" mass="2.0" contype="1" conaffinity="0" condim="3"/>
      <site name="winch_site" pos="0 0 0.09"/>
    </body>
    <body name="deckbase" pos="0.2 0 0.15">
      <geom name="base_geom" type="box" size="0.06 0.12 0.15" pos="0 0 -0.075" rgba="0.5 0.5 0.55 1" mass="0" contype="1" conaffinity="0" condim="3"/>
      <body name="deck" pos="0 0 0">
        <joint name="hinge" type="hinge" axis="0 1 0" limited="true" range="-1.0 0.13" damping="0.5"/>
        <geom name="deck_geom" type="box" size="0.45 0.1 0.03" pos="0.45 0 0" rgba="0.75 0.5 0.25 1" mass="0.4" friction="1.0 0.05 0.02" contype="1" conaffinity="0" condim="3"/>
        <geom name="lip_geom" type="box" size="0.02 0.1 0.05" pos="0.88 0 0.05" rgba="0.7 0.45 0.2 1" mass="0.05" contype="1" conaffinity="0" condim="3"/>
        <site name="deck_tip" pos="0.88 0 0.03"/>
      </body>
    </body>
    <body name="crate" pos="0.75 0 0.24">
      <freejoint name="crate_free"/>
      <geom name="crate_geom" type="box" size="0.07 0.07 0.07" rgba="0.2 0.6 0.3 1" mass="0.3" friction="1.0 0.05 0.02" contype="1" conaffinity="0" condim="3"/>
    </body>
  </worldbody>
  <contact>
    <pair geom1="crate_geom" geom2="deck_geom"/>
    <pair geom1="crate_geom" geom2="lip_geom"/>
    <pair geom1="crate_geom" geom2="floor" condim="1"/>
  </contact>
  <tendon>
    <spatial name="cable" stiffness="300" damping="12" springlength="1.25 1.25">
      <site site="winch_site"/>
      <geom geom="bollard_geom" sidesite="mid"/>
      <site site="mid"/>
      <pulley divisor="3"/>
      <site site="deck_tip"/>
      <site site="anchor"/>
    </spatial>
  </tendon>
  <actuator>
    <general joint="winch" dyntype="filter" dynprm="0.03 0 0" gainprm="60 0 8" biastype="none"/>
  </actuator>
  <keyframe>
    <key name="start" qpos="0.55 0.13 0.75 0 0.28 1 0 0 0" act="0"/>
  </keyframe>
</mujoco>
