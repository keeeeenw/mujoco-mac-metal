// Pinned mjc_FlexSDF helpers (3.10.0): triangle circum-sphere culling and
// Frank-Wolfe minimization over the triangle using the compiled mesh octree.
static inline FlexDD flex_sdf_source_distance(
    device const float* hull, int co, int nn, int low_ab, int tail_ab,
    int low_coeff, int tail_coeff, FlexDD3 point);

static inline float flex_sdf_source_value(FlexDD value) {
  return (value.hi+value.lo)+value.tail;
}

inline bool flex_sdf_triangle_intersects(thread const FlexDD3* tri,
                                         device const float* hull,
                                         int oct_offset, int oct_nodes,
                                         int low_ab, int tail_ab,
                                         int low_coeff, int tail_coeff) {
  FlexDD3 edge0=flex_dd3_source_sub(tri[1],tri[0]);
  FlexDD3 edge1=flex_dd3_source_sub(tri[2],tri[0]);
  FlexDD3 normal=flex_dd3_cross(edge0,edge1);
  FlexDD normal_length=flex_dd_sqrt(flex_dd3_dot(normal,normal));
  FlexDD minval=FlexDD{1.0000000036274937e-15f,
                       -3.627493647833322e-24f,0.0f};
  if (flex_dd_compare(normal_length,minval)<0) {
    normal=flex_dd3(float3(1.0f,0.0f,0.0f));
  } else {
    FlexDD inv_normal=flex_dd_source_div(flex_dd(1.0f),normal_length);
    normal=flex_dd3_scale(normal,inv_normal);
  }
  FlexDD third=FlexDD{0.3333333432674408f,-9.934107758624577e-9f,
                       2.7755575615628914e-16f};
  FlexDD3 center=flex_dd3_scale(tri[0],third);
  center=flex_dd3_source_madd(tri[1],third,center);
  center=flex_dd3_source_madd(tri[2],third,center);
  FlexDD center_dist=flex_sdf_source_distance(
      hull,oct_offset,oct_nodes,low_ab,tail_ab,low_coeff,tail_coeff,
      center);
  FlexDD h=flex_dd_neg(flex_dd_source_div(
      center_dist,flex_dd(10.0f)));
  FlexDD k_min_height=FlexDD{
      0.10000000149011612f,-1.4901161415892261e-9f,
      2.7755575615628914e-17f};
  if (flex_dd_compare(flex_dd_abs(h),k_min_height)<0) {
    FlexDD a=flex_dd_sqrt(flex_dd3_dot(edge0,edge0));
    FlexDD3 edge_b=flex_dd3_source_sub(tri[2],tri[1]);
    FlexDD b=flex_dd_sqrt(flex_dd3_dot(edge_b,edge_b));
    FlexDD3 edge_c=flex_dd3_source_sub(tri[0],tri[2]);
    FlexDD c=flex_dd_sqrt(flex_dd3_dot(edge_c,edge_c));
    FlexDD perimeter=flex_dd_source_add(
        flex_dd_source_add(a,b),c);
    FlexDD s=flex_dd_source_mul(perimeter,flex_dd(0.5f));
    FlexDD area2=flex_dd_source_mul(s,flex_dd_source_sub(s,a));
    area2=flex_dd_source_mul(area2,flex_dd_source_sub(s,b));
    area2=flex_dd_source_mul(area2,flex_dd_source_sub(s,c));
    FlexDD area=flex_dd_sqrt(area2);
    if (flex_dd_compare(area,minval)<0) area=minval;
    FlexDD radius=flex_dd_source_mul(
        flex_dd_source_mul(a,b),c);
    radius=flex_dd_source_div(
        radius,flex_dd_source_mul(flex_dd(4.0f),area));
    return flex_dd_compare(center_dist,radius)<0;
  }
  FlexDD3 p=flex_dd3_source_madd(normal,flex_dd_neg(h),center);
  FlexDD3 v0=flex_dd3_source_sub(tri[0],p);
  FlexDD3 v1=flex_dd3_source_sub(tri[1],p);
  FlexDD3 v2=flex_dd3_source_sub(tri[2],p);
  FlexDD3 c0=flex_dd3_cross(v1,v2);
  FlexDD3 c1=flex_dd3_cross(v2,v0);
  FlexDD3 c2=flex_dd3_cross(v0,v1);
  FlexDD den=flex_dd_source_mul(
      flex_dd(2.0f),flex_dd3_dot(v0,c0));
  if (flex_dd_compare(flex_dd_abs(den),minval)<0)
    return flex_dd_compare(
        center_dist,flex_dd_sqrt(flex_dd3_dot(edge0,edge0)))<0;
  FlexDD3 sphere_center=flex_dd3_scale(c0,flex_dd3_dot(v0,v0));
  sphere_center=flex_dd3_source_madd(
      c1,flex_dd3_dot(v1,v1),sphere_center);
  sphere_center=flex_dd3_source_madd(
      c2,flex_dd3_dot(v2,v2),sphere_center);
  FlexDD inv_den=flex_dd_source_div(flex_dd(1.0f),den);
  sphere_center=flex_dd3_scale(sphere_center,inv_den);
  FlexDD radius=flex_dd_sqrt(flex_dd3_dot(sphere_center,sphere_center));
  sphere_center=flex_dd3_source_madd(sphere_center,flex_dd(1.0f),p);
  return flex_dd_compare(
      flex_sdf_source_distance(
          hull,oct_offset,oct_nodes,low_ab,tail_ab,low_coeff,tail_coeff,
          sphere_center),radius)<0;
}

static inline FlexDD flex_sdf_oct_value(
    device const float* hull, int high, int low, int tail, int index) {
  return FlexDD{hull[high+index],hull[low+index],hull[tail+index]};
}

// These are source mjtNum constants. Keep the binary64 literals as expansion
// words; converting the decimal literal directly to float silently discards
// the exact epsilon that participates in octree leaf and projection tests.
static inline FlexDD flex_sdf_box_projection_epsilon() {
  return FlexDD{9.9999999747524271e-7f,2.5247572468697606e-15f,0.0f};
}

static inline FlexDD flex_sdf_octree_epsilon() {
  return FlexDD{9.9999999392252903e-9f,6.0774706609724659e-17f,
                3.3087224502121107e-24f};
}

static inline FlexDD3 flex_sdf_oct_box_center(
    device const float* hull, int high, int low, int tail) {
  return FlexDD3{flex_sdf_oct_value(hull,high,low,tail,0),
                 flex_sdf_oct_value(hull,high,low,tail,1),
                 flex_sdf_oct_value(hull,high,low,tail,2)};
}

static inline FlexDD3 flex_sdf_oct_box_extent(
    device const float* hull, int high, int low, int tail) {
  return FlexDD3{flex_sdf_oct_value(hull,high,low,tail,3),
                 flex_sdf_oct_value(hull,high,low,tail,4),
                 flex_sdf_oct_value(hull,high,low,tail,5)};
}

static inline FlexDD flex_sdf_source_box_project(
    thread FlexDD3& point, FlexDD3 center, FlexDD3 extent) {
  FlexDD3 r=flex_dd3_source_sub(point,center);
  FlexDD3 q=FlexDD3{
      flex_dd_source_sub(flex_dd_abs(r.x),extent.x),
      flex_dd_source_sub(flex_dd_abs(r.y),extent.y),
      flex_dd_source_sub(flex_dd_abs(r.z),extent.z)};
  if (flex_dd_compare(q.x,flex_dd(0.0f))<=0
      && flex_dd_compare(q.y,flex_dd(0.0f))<=0
      && flex_dd_compare(q.z,flex_dd(0.0f))<=0) {
    FlexDD result=flex_dd_compare(q.y,q.z)>0 ? q.y : q.z;
    return flex_dd_compare(q.x,result)>0 ? q.x : result;
  }
  FlexDD squared=flex_dd(0.0f), eps=flex_sdf_box_projection_epsilon();
  if (flex_dd_compare(q.x,flex_dd(0.0f))>=0) {
    squared=flex_dd_source_add(squared,flex_dd_source_mul(q.x,q.x));
    FlexDD offset=flex_dd_source_add(q.x,eps);
    point.x=flex_dd_compare(r.x,flex_dd(0.0f))>0
        ? flex_dd_source_sub(point.x,offset)
        : flex_dd_source_add(point.x,offset);
  }
  if (flex_dd_compare(q.y,flex_dd(0.0f))>=0) {
    squared=flex_dd_source_add(squared,flex_dd_source_mul(q.y,q.y));
    FlexDD offset=flex_dd_source_add(q.y,eps);
    point.y=flex_dd_compare(r.y,flex_dd(0.0f))>0
        ? flex_dd_source_sub(point.y,offset)
        : flex_dd_source_add(point.y,offset);
  }
  if (flex_dd_compare(q.z,flex_dd(0.0f))>=0) {
    squared=flex_dd_source_add(squared,flex_dd_source_mul(q.z,q.z));
    FlexDD offset=flex_dd_source_add(q.z,eps);
    point.z=flex_dd_compare(r.z,flex_dd(0.0f))>0
        ? flex_dd_source_sub(point.z,offset)
        : flex_dd_source_add(point.z,offset);
  }
  return flex_dd_sqrt(squared);
}

static inline bool flex_sdf_source_leaf(
    device const float* hull, int co, int nn, int low_ab, int tail_ab,
    FlexDD3 p,
    thread int& leaf, thread FlexDD3& coord) {
  FlexDD eps=flex_sdf_octree_epsilon();
  int node=0;
  for (int iter=0;iter<100;iter++) {
    int ab=co+8*nn+6*node;
    int lab=low_ab+6*node, tab=tail_ab+6*node;
    FlexDD3 center=flex_sdf_oct_box_center(hull,ab,lab,tab);
    FlexDD3 extent=flex_sdf_oct_box_extent(hull,ab,lab,tab);
    FlexDD3 lo=flex_dd3_source_sub(center,extent);
    FlexDD3 hi=flex_dd3_source_madd(extent,flex_dd(1.0f),center);
    FlexDD3 pe=flex_dd3_source_madd(
        FlexDD3{eps,eps,eps},flex_dd(1.0f),p);
    FlexDD3 pm=flex_dd3_source_sub(p,FlexDD3{eps,eps,eps});
    if (flex_dd_compare(pe.x,lo.x)<0 || flex_dd_compare(pm.x,hi.x)>0
        || flex_dd_compare(pe.y,lo.y)<0 || flex_dd_compare(pm.y,hi.y)>0
        || flex_dd_compare(pe.z,lo.z)<0 || flex_dd_compare(pm.z,hi.z)>0)
      return false;
    FlexDD3 width=flex_dd3_source_sub(hi,lo);
    coord=flex_dd3_div(flex_dd3_source_sub(p,lo),width.x);
    // The octree is cubic for the compiled mesh fixture. Keep the general
    // per-axis denominator instead of assuming equal extents.
    coord.y=flex_dd_source_div(flex_dd_source_sub(p.y,lo.y),width.y);
    coord.z=flex_dd_source_div(flex_dd_source_sub(p.z,lo.z),width.z);
    int cb=co+8*node;
    bool is_leaf=true;
    for (int k=0;k<8;k++)
      if (int(hull[cb+k])!=-1) { is_leaf=false; break; }
    if (is_leaf) { leaf=node; return true; }
    int xi=flex_dd_compare(coord.x,flex_dd(0.5f))<0 ? 0 : 1;
    int yi=flex_dd_compare(coord.y,flex_dd(0.5f))<0 ? 0 : 1;
    int zi=flex_dd_compare(coord.z,flex_dd(0.5f))<0 ? 0 : 1;
    node=int(hull[cb+4*zi+2*yi+xi]);
    if (node<0 || node>=nn) return false;
  }
  return false;
}

static inline void flex_sdf_source_weights(
    FlexDD3 coord, thread FlexDD* weights, thread FlexDD3* gradients) {
  for (int j=0;j<8;j++) {
    FlexDD x=(j&1) ? coord.x : flex_dd_source_sub(flex_dd(1.0f),coord.x);
    FlexDD y=(j&2) ? coord.y : flex_dd_source_sub(flex_dd(1.0f),coord.y);
    FlexDD z=(j&4) ? coord.z : flex_dd_source_sub(flex_dd(1.0f),coord.z);
    weights[j]=flex_dd_source_mul(flex_dd_source_mul(x,y),z);
    if (gradients) {
      FlexDD sx=(j&1) ? flex_dd(1.0f) : flex_dd(-1.0f);
      FlexDD sy=(j&2) ? flex_dd(1.0f) : flex_dd(-1.0f);
      FlexDD sz=(j&4) ? flex_dd(1.0f) : flex_dd(-1.0f);
      gradients[j]=FlexDD3{
          flex_dd_source_mul(flex_dd_source_mul(sx,y),z),
          flex_dd_source_mul(flex_dd_source_mul(x,sy),z),
          flex_dd_source_mul(flex_dd_source_mul(x,y),sz)};
    }
  }
}

static inline FlexDD3 flex_sdf_source_gradient(
    device const float* hull, int co, int nn,
    int low_ab, int tail_ab, int low_coeff, int tail_coeff,
    FlexDD3 point) {
  int ab=co+8*nn;
  FlexDD3 center=flex_sdf_oct_box_center(hull,ab,low_ab,tail_ab);
  FlexDD3 extent=flex_sdf_oct_box_extent(hull,ab,low_ab,tail_ab);
  FlexDD3 delta=flex_dd3_source_sub(point,center);
  bool inside=flex_dd_compare(flex_dd_source_sub(flex_dd_abs(delta.x),extent.x),
                              flex_dd(0.0f))<=0
      && flex_dd_compare(flex_dd_source_sub(flex_dd_abs(delta.y),extent.y),
                         flex_dd(0.0f))<=0
      && flex_dd_compare(flex_dd_source_sub(flex_dd_abs(delta.z),extent.z),
                         flex_dd(0.0f))<=0;
  if (inside) {
    int leaf=-1;
    FlexDD3 coord=flex_dd3(float3(0.0f));
    if (flex_sdf_source_leaf(hull,co,nn,low_ab,tail_ab,
                             point,leaf,coord)) {
      thread FlexDD weights[8];
      thread FlexDD3 derivatives[8];
      flex_sdf_source_weights(coord,weights,derivatives);
      FlexDD3 grad=flex_dd3(float3(0.0f));
      int fb=co+14*nn+8*leaf;
      int lfb=low_coeff+8*leaf, tfb=tail_coeff+8*leaf;
      for (int i=0;i<8;i++) {
        FlexDD c=flex_sdf_oct_value(hull,fb,lfb,tfb,i);
        grad.x=flex_dd_source_fma(derivatives[i].x,c,grad.x);
        grad.y=flex_dd_source_fma(derivatives[i].y,c,grad.y);
        grad.z=flex_dd_source_fma(derivatives[i].z,c,grad.z);
      }
      return grad;
    }
  }
  // Exterior octree gradients use pinned mjc_gradient's forward 1e-8
  // difference, with the full represented point and compiled octree words.
  FlexDD eps=flex_sdf_octree_epsilon();
  FlexDD d0=flex_sdf_source_distance(
      hull,co,nn,low_ab,tail_ab,low_coeff,tail_coeff,point);
  FlexDD3 px=point, py=point, pz=point;
  px.x=flex_dd_source_add(px.x,eps);
  py.y=flex_dd_source_add(py.y,eps);
  pz.z=flex_dd_source_add(pz.z,eps);
  FlexDD dx=flex_sdf_source_distance(
      hull,co,nn,low_ab,tail_ab,low_coeff,tail_coeff,px);
  FlexDD dy=flex_sdf_source_distance(
      hull,co,nn,low_ab,tail_ab,low_coeff,tail_coeff,py);
  FlexDD dz=flex_sdf_source_distance(
      hull,co,nn,low_ab,tail_ab,low_coeff,tail_coeff,pz);
  return FlexDD3{flex_dd_source_div(flex_dd_source_sub(dx,d0),eps),
                 flex_dd_source_div(flex_dd_source_sub(dy,d0),eps),
                 flex_dd_source_div(flex_dd_source_sub(dz,d0),eps)};
}

static inline FlexDD flex_sdf_source_distance(
    device const float* hull, int co, int nn,
    int low_ab, int tail_ab, int low_coeff, int tail_coeff,
    FlexDD3 point) {
  int ab=co+8*nn;
  FlexDD3 center=flex_sdf_oct_box_center(hull,ab,low_ab,tail_ab);
  FlexDD3 extent=flex_sdf_oct_box_extent(hull,ab,low_ab,tail_ab);
  FlexDD3 projected=point;
  FlexDD box_dist=flex_sdf_source_box_project(projected,center,extent);
  int leaf=-1;
  FlexDD3 coord=flex_dd3(float3(0.0f));
  if (!flex_sdf_source_leaf(hull,co,nn,low_ab,tail_ab,
                            projected,leaf,coord))
    return box_dist;
  thread FlexDD weights[8];
  flex_sdf_source_weights(coord,weights,nullptr);
  FlexDD distance=flex_dd(0.0f);
  int fb=co+14*nn+8*leaf;
  int lfb=low_coeff+8*leaf, tfb=tail_coeff+8*leaf;
  for (int i=0;i<8;i++)
    distance=flex_dd_source_add(distance,
        flex_dd_source_mul(weights[i],
                           flex_sdf_oct_value(hull,fb,lfb,tfb,i)));
  return flex_dd_compare(box_dist,flex_dd(0.0f))>0
      ? flex_dd_source_add(distance,box_dist) : distance;
}

static inline FlexDD flex_sdf_source_halton(int index, int base) {
  int n=index;
  FlexDD divisor=flex_dd(float(base));
  FlexDD factor=flex_dd_source_div(flex_dd(1.0f),divisor);
  FlexDD value=flex_dd(0.0f);
  while (n>0) {
    int next=n/base;
    int remainder=n-next*base;
    value=flex_dd_source_add(value,
        flex_dd_source_mul(factor,flex_dd(float(remainder))));
    factor=flex_dd_source_div(factor,divisor);
    n=next;
  }
  return value;
}

static inline FlexDD3 flex_sdf_quat_rotate(float4 q, FlexDD3 v) {
  FlexDD3 qv=flex_dd3(float3(q.y,q.z,q.w));
  FlexDD3 t=flex_dd3_scale(flex_dd3_cross(qv,v),flex_dd(2.0f));
  FlexDD3 out=flex_dd3_source_madd(t,flex_dd(q.x),v);
  return flex_dd3_source_madd(flex_dd3_cross(qv,t),flex_dd(1.0f),out);
}

inline FlexDD flex_sdf_frank_wolfe(thread FlexDD3& x,
                                 thread const FlexDD3* tri,
                                 int iterations,
                                 device const float* hull,
                                 int oct_offset, int oct_nodes,
                                 int low_ab, int tail_ab,
                                 int low_coeff, int tail_coeff) {
  for (int step=0; step<iterations; ++step) {
    FlexDD3 grad=flex_sdf_source_gradient(
        hull,oct_offset,oct_nodes,low_ab,tail_ab,low_coeff,tail_coeff,x);
    int best=0;
    FlexDD best_value=flex_dd3_dot(tri[0],grad);
    for (int i=1; i<3; ++i) {
      FlexDD value=flex_dd3_dot(tri[i],grad);
      // Source stepFrankWolfe uses a strict binary64 '<'. The operands and
      // dot contraction above retain the same represented values; no
      // geometric epsilon is introduced for near-ties.
      if (flex_dd_compare_exact(value,best_value)<0) {
        best_value=value;
        best=i;
      }
    }
    FlexDD3 direction=flex_dd3_source_sub(tri[best],x);
    FlexDD scale=flex_dd_source_div(flex_dd(2.0f),flex_dd(float(step+2)));
    x=flex_dd3_source_madd(direction,scale,x);
  }
  return flex_sdf_source_distance(
      hull,oct_offset,oct_nodes,low_ab,tail_ab,low_coeff,tail_coeff,x);
}

inline int flex_sdf_triangle_contact(
    int env, int batch, int nvert, int slot, int geom, int flex_id, int ngeom,
    int seed_ordinal, int bvh_enabled,
    device const int* candidate_nodes, device const float* flexvert_xpos,
    device const float* flexvert_xpos_low,
    device const float* geom_pos, device const float* geom_quat,
    device const float* flex_radius, device const float* hull,
    device const int* hull_info, int initpoints,
    thread ContactGeom& contact, thread float4& weights,
    thread float3& selection_point, thread FlexDD3& selection_exact,
    thread FlexDD3& contact_point_exact) {
  selection_point=float3(0.0f);
  int base=slot*4;
  int v0=candidate_nodes[base], v1=candidate_nodes[base+1],
      v2=candidate_nodes[base+2];
  if (v0<0 || v1<0 || v2<0) return 0;
  int info=geom*9;
  int oct_offset=hull_info[info], oct_nodes=hull_info[info+1];
  int iterations=hull_info[info+2];
  int low_ab=hull_info[info+4], tail_ab=hull_info[info+5];
  int low_coeff=hull_info[info+6], tail_coeff=hull_info[info+7];
  if (oct_offset<0 || oct_nodes<=0 || iterations<=0
      || low_ab<0 || tail_ab<0 || low_coeff<0 || tail_coeff<0) return 0;
  float3 gp=float3(geom_pos[(env*ngeom+geom)*3],
                   geom_pos[(env*ngeom+geom)*3+1],
                   geom_pos[(env*ngeom+geom)*3+2]);
  float4 gq=float4(geom_quat[(env*ngeom+geom)*4],
                   geom_quat[(env*ngeom+geom)*4+1],
                   geom_quat[(env*ngeom+geom)*4+2],
                   geom_quat[(env*ngeom+geom)*4+3]);
  int vertex_words=batch*nvert*3;
  int geom_words=batch*ngeom*3;
  int geom_base=(env*ngeom+geom)*3;
  int geom_low_base=2*vertex_words+geom_base;
  int geom_tail_base=2*vertex_words+geom_words+geom_base;
  FlexDD3 geom_exact=FlexDD3{
      FlexDD{gp.x,flexvert_xpos_low[geom_low_base],
             flexvert_xpos_low[geom_tail_base]},
      FlexDD{gp.y,flexvert_xpos_low[geom_low_base+1],
             flexvert_xpos_low[geom_tail_base+1]},
      FlexDD{gp.z,flexvert_xpos_low[geom_low_base+2],
             flexvert_xpos_low[geom_tail_base+2]}};
  FlexDD3 tri_exact[3];
  tri_exact[0]=flex_sdf_quat_rotate(float4(gq.x,-gq.y,-gq.z,-gq.w),
      flex_dd3_source_sub(flex_world_vertex_dd(
          flexvert_xpos,flexvert_xpos_low,env,nvert,batch,v0),geom_exact));
  tri_exact[1]=flex_sdf_quat_rotate(float4(gq.x,-gq.y,-gq.z,-gq.w),
      flex_dd3_source_sub(flex_world_vertex_dd(
          flexvert_xpos,flexvert_xpos_low,env,nvert,batch,v1),geom_exact));
  tri_exact[2]=flex_sdf_quat_rotate(float4(gq.x,-gq.y,-gq.z,-gq.w),
      flex_dd3_source_sub(flex_world_vertex_dd(
          flexvert_xpos,flexvert_xpos_low,env,nvert,batch,v2),geom_exact));
  if (bvh_enabled) {
    // Pinned traverseBVH.boxIntersect tests the current leaf AABB (expanded
    // by flex radius) by transforming its center and using the AABB
    // half-diagonal as a bounding sphere. This precedes triangleIntersect in
    // mjc_FlexSDF and can reject elements that the triangle test alone keeps.
    float3 lo=flex_world_vertex(flexvert_xpos,env,nvert,v0);
    float3 hi=lo;
    float3 p1=flex_world_vertex(flexvert_xpos,env,nvert,v1);
    float3 p2=flex_world_vertex(flexvert_xpos,env,nvert,v2);
    lo=min(lo,min(p1,p2));
    hi=max(hi,max(p1,p2));
    float3 half_extent=0.5f*(hi-lo)+float3(flex_radius[flex_id]);
    float3 world_center=0.5f*(hi+lo);
    float3 local_center=quat_unrotate(gq,world_center-gp);
    if (flex_dd_compare(
            flex_sdf_source_distance(
                hull,oct_offset,oct_nodes,low_ab,tail_ab,
                low_coeff,tail_coeff,flex_dd3(local_center)),
            flex_dd(length(half_extent)))>=0)
      return 0;
  }
  if (!flex_sdf_triangle_intersects(
          tri_exact,hull,oct_offset,oct_nodes,
          low_ab,tail_ab,low_coeff,tail_coeff))
    return 0;
  FlexDD best_depth=flex_dd(0.0f);
  FlexDD3 best_point=flex_dd3(float3(0.0f));
  bool have_best=false;
  int nseed=min(max(initpoints,1),50);
  int first_seed=seed_ordinal>=0 ? seed_ordinal : 0;
  int last_seed=seed_ordinal>=0 ? seed_ordinal+1 : nseed;
  if (first_seed>=nseed) return 0;
  for (int seed=first_seed; seed<last_seed; ++seed) {
    FlexDD u=flex_sdf_source_halton(seed+1,2);
    FlexDD v=flex_sdf_source_halton(seed+1,3);
    if (flex_dd_compare(flex_dd_source_add(u,v),flex_dd(1.0f))>0) {
      u=flex_dd_source_sub(flex_dd(1.0f),u);
      v=flex_dd_source_sub(flex_dd(1.0f),v);
    }
    FlexDD b0=flex_dd_source_sub(flex_dd_source_sub(flex_dd(1.0f),u),v);
    FlexDD3 x;
    // Pinned 3.10 arm64 processSdfCorners contracts the source expression as
    // round(u*c1), then fma(b0,c0,acc), then fma(v,c2,acc). Its compiled
    // _processSdfCorners sequence is fmul(c1,u), fmla(c0,b0), fmla(c2,v).
    x.x=flex_dd_source_fma(b0,tri_exact[0].x,
        flex_dd_source_mul(u,tri_exact[1].x));
    x.x=flex_dd_source_fma(v,tri_exact[2].x,x.x);
    x.y=flex_dd_source_fma(b0,tri_exact[0].y,
        flex_dd_source_mul(u,tri_exact[1].y));
    x.y=flex_dd_source_fma(v,tri_exact[2].y,x.y);
    x.z=flex_dd_source_fma(b0,tri_exact[0].z,
        flex_dd_source_mul(u,tri_exact[1].z));
    x.z=flex_dd_source_fma(v,tri_exact[2].z,x.z);
    FlexDD depth=flex_sdf_frank_wolfe(
        x,tri_exact,iterations,hull,oct_offset,oct_nodes,
        low_ab,tail_ab,low_coeff,tail_coeff);
    if (flex_dd_compare(depth,flex_dd(0.0f))<0
        && (!have_best || flex_dd_compare_exact(depth,best_depth)<0)) {
      best_depth=depth;
      best_point=x;
      have_best=true;
    }
  }
  if (!have_best) return 0;
  selection_exact=best_point;
  selection_point=flex_dd3_high(best_point);
  FlexDD3 local_normal=flex_sdf_source_gradient(
      hull,oct_offset,oct_nodes,low_ab,tail_ab,low_coeff,tail_coeff,
      best_point);
  FlexDD normal_length=flex_dd_sqrt(flex_dd3_dot(
      local_normal,local_normal));
  if (flex_dd_compare(normal_length,flex_dd(1.0e-15f))<0) return 0;
  local_normal=flex_dd3_div(local_normal,normal_length);
  FlexDD3 world_normal=flex_sdf_quat_rotate(gq,local_normal);
  FlexDD3 world_point=flex_dd3_source_madd(
      flex_sdf_quat_rotate(gq,best_point),flex_dd(1.0f),geom_exact);
  FlexDD half_negative=flex_dd_source_mul(best_depth,flex_dd(-0.5f));
  contact_point_exact=flex_dd3_source_madd(
      world_normal,half_negative,world_point);
  contact.dist=best_depth.hi;
  contact.normal=flex_dd3_high(world_normal);
  contact.pos=flex_dd3_high(contact_point_exact);
  contact.t1=float3(0.0f);
  make_frame(contact.normal,contact.t1,contact.t2);
  FlexDD3 a=flex_dd3_source_sub(tri_exact[1],tri_exact[0]);
  FlexDD3 b=flex_dd3_source_sub(tri_exact[2],tri_exact[0]);
  FlexDD3 p=flex_dd3_source_sub(best_point,tri_exact[0]);
  FlexDD aa=flex_dd3_dot(a,a);
  FlexDD ab=flex_dd3_dot(a,b);
  FlexDD bb=flex_dd3_dot(b,b);
  FlexDD ap=flex_dd3_dot(a,p);
  FlexDD bp=flex_dd3_dot(b,p);
  FlexDD denom=flex_dd_source_sub(flex_dd_source_mul(aa,bb),
                                 flex_dd_source_mul(ab,ab));
  if (flex_dd_compare(flex_dd_abs(denom),flex_dd(1e-20f))<0) return 0;
  FlexDD u=flex_dd_source_div(
      flex_dd_source_sub(flex_dd_source_mul(bb,ap),
                         flex_dd_source_mul(ab,bp)),denom);
  FlexDD v=flex_dd_source_div(
      flex_dd_source_sub(flex_dd_source_mul(aa,bp),
                         flex_dd_source_mul(ab,ap)),denom);
  weights=float4(flex_dd_source_sub(
      flex_dd_source_sub(flex_dd(1.0f),u),v).hi,u.hi,v.hi,0.0f);
  return 1;
}

static inline float flex_area_sign(float2 p1, float2 p2, float2 p3) {
  return sign((p1.x-p3.x)*(p2.y-p3.y)-(p2.x-p3.x)*(p1.y-p3.y));
}

static inline float flex_point_segment(float2 p, float2 u, float2 v,
                                       thread float2& result,
                                       thread float& parameter) {
  float2 uv=v-u;
  float denominator=max(1e-15f,dot(uv,uv));
  parameter=clamp(dot(uv,p-u)/denominator,0.0f,1.0f);
  result=u+parameter*uv;
  return length(result-p);
}

// Pinned mjraw_SphereTriangle projection, area-sign inside test, strict edge
// tie ordering, and nearest-point construction.
static inline bool flex_raw_sphere_triangle(
    float3 sphere, float sphere_radius, float3 t1, float3 t2, float3 t3,
    float flex_radius, float margin, thread ContactGeom& con,
    thread float4& bary) {
  float3 S=sphere-t1, A=t2-t1, B=t3-t1;
  float3 N=cross(A,B);
  float nlen=length(N);
  if (nlen>0.0f) N/=nlen;
  float dstS=dot(N,S);
  float rbound=margin+sphere_radius+flex_radius;
  if (abs(dstS)>rbound) return false;
  float3 P=S-N*dstS;
  float3 V1=A;
  float lenA=length(V1);
  if (lenA>0.0f) V1/=lenA;
  float3 V2=cross(N,A);
  float lenV2=length(V2);
  if (lenV2>0.0f) V2/=lenV2;
  float2 o=float2(0.0f), a=float2(lenA,0.0f);
  float2 b=float2(dot(V1,B),dot(V2,B));
  float2 p=float2(dot(V1,P),dot(V2,P));
  float sign1=flex_area_sign(p,o,a);
  float sign2=flex_area_sign(p,a,b);
  float sign3=flex_area_sign(p,b,o);
  float3 closest;
  float u=0.0f,v=0.0f,w=0.0f;
  if (sign1==sign2 && sign2==sign3) {
    closest=P;
    float denominator=lenA*b.y;
    if (abs(denominator)>1e-30f) {
      v=(p.x*b.y-b.x*p.y)/denominator;
      w=lenA*p.y/denominator;
      u=1.0f-v-w;
    } else {
      float2 point; float t;
      float d0=flex_point_segment(p,o,a,point,t);
      float2 best=point; u=1.0f-t; v=t; w=0.0f;
      float2 point1;
      float d1=flex_point_segment(p,a,b,point1,t);
      if (d1<d0) { best=point1; u=0.0f; v=1.0f-t; w=t; d0=d1; }
      float2 point2;
      float d2=flex_point_segment(p,b,o,point2,t);
      if (d2<d0) { best=point2; u=t; v=0.0f; w=1.0f-t; }
      closest=V1*best.x+V2*best.y;
    }
  } else {
    float2 x0,x1,x2;
    float t0,t1,t2;
    float d0=flex_point_segment(p,o,a,x0,t0);
    float d1=flex_point_segment(p,a,b,x1,t1);
    float d2=flex_point_segment(p,b,o,x2,t2);
    int best=(d0<d1 && d0<d2) ? 0 : (d1<d2 ? 1 : 2);
    if (best==0) { closest=V1*x0.x+V2*x0.y; u=1.0f-t0; v=t0; }
    else if (best==1) { closest=V1*x1.x+V2*x1.y; v=1.0f-t1; w=t1; }
    else { closest=V1*x2.x+V2*x2.y; u=t2; w=1.0f-t2; }
  }
  float3 delta=closest-S;
  float distance=length(delta);
  if (distance>rbound) return false;
  float contact_distance=distance-sphere_radius-flex_radius;
  float3 normal=distance>1e-15f ? delta/distance : float3(0.0f);
  con.dist=contact_distance;
  con.normal=normal;
  con.pos=sphere+normal*(sphere_radius+0.5f*contact_distance);
  con.t1=float3(0.0f);
  make_frame(con.normal,con.t1,con.t2);
  bary=float4(u,v,w,0.0f);
  return true;
}

// Pinned engine_core_constraint.c:mj_elemBodyWeight vertex weights. These
// weights drive generalized contact J through mj_jacSum; geometric
// barycentrics are kept separately for witness reporting.
inline float4 flex_contact_jac_weights(
    int flex, int elem, int vert, int other_flex, int other_vert,
    float3 point, int env, int slot, int nvert,
    device const int* nodes, device const int* flex_vertadr,
    device const float* flexvert_xpos) {
  float4 weights=float4(0.0f);
  int base=slot*4;
  if (flex<0) return weights;
  if (vert>=0) {
    for (int i=0;i<4;i++)
      if (nodes[base+i]==vert) { weights[i]=1.0f; break; }
    return weights;
  }
  if (elem<0) return weights;
  int opposite_local=(other_flex>=0 && other_vert>=0)
      ? other_vert-flex_vertadr[other_flex] : -1;
  float sum=0.0f;
  for (int i=0;i<4;i++) {
    int node=nodes[base+i];
    if (node<0) continue;
    if (opposite_local>=0 && node-flex_vertadr[flex]==opposite_local) continue;
    float3 x=float3(flexvert_xpos[(env*nvert+node)*3],
                    flexvert_xpos[(env*nvert+node)*3+1],
                    flexvert_xpos[(env*nvert+node)*3+2]);
    weights[i]=1.0f/max(length(x-point),1.0e-15f);
    sum+=weights[i];
  }
  if (sum>1.0e-15f) weights/=sum;
  return weights;
}

kernel void flex_contact_detect(
    device const int* candidate_meta [[buffer(0)]],
    device const int* candidate_nodes1 [[buffer(1)]],
    device const int* candidate_nodes2 [[buffer(2)]],
    device const float* flexvert_xpos [[buffer(3)]],
    device const float* geom_pos [[buffer(4)]],
    device const float* geom_quat [[buffer(5)]],
    device const float* geom_size [[buffer(6)]],
    device const int* geom_type [[buffer(7)]],
    device const float* flex_radius [[buffer(8)]],
    device const float* flex_radius2 [[buffer(9)]],
    device const float* candidate_margin_gap [[buffer(10)]],
    device const float* geom_hull [[buffer(11)]],
    device const int* geom_hull_info [[buffer(12)]],
    constant int* dims [[buffer(13)]],
    device int* active [[buffer(14)]],
    device float* distance [[buffer(15)]],
    device float* contact_pos [[buffer(16)]],
    device float* contact_normal [[buffer(17)]],
    device float* barycentric1 [[buffer(18)]],
    device float* barycentric2 [[buffer(19)]],
    device float* contact_frame [[buffer(20)]],
    device float* candidate_selection_pos [[buffer(21)]],
    device const int* flex_vertadr [[buffer(22)]],
    device float* jacobian_weights [[buffer(23)]],
    constant float* ccd_tolerance [[buffer(24)]],
    device int* narrowphase_status [[buffer(25)]],
    device float* ccd_trace [[buffer(26)]],
    device const float* flex_radius_midlow [[buffer(27)]],
    device const float* margin_gap_midlow [[buffer(28)]],
    device const float* flexvert_xpos_low [[buffer(29)]],
    device float* contact_pos_low_tail [[buffer(30)]],
    uint tid [[thread_position_in_grid]]) {
  int batch = dims[0], nslot = dims[1], nvert = dims[2], ngeom = dims[3];
  bool nativeccd = dims[4] != 0;
  bool capture_ccd_trace = dims[7] != 0;
  if (tid >= uint(batch*nslot)) return;
  int slot = int(tid) % nslot, env = int(tid) / nslot;
  FlexDD exact_margin=FlexDD{candidate_margin_gap[2*slot],
      margin_gap_midlow[4*slot],margin_gap_midlow[4*slot+1]};
  FlexDD exact_gap=FlexDD{candidate_margin_gap[2*slot+1],
      margin_gap_midlow[4*slot+2],margin_gap_midlow[4*slot+3]};
  FlexDD exact_threshold=flex_dd_source_add(exact_margin,exact_gap);
  // Recovery-mask suffix starts after the fixed 23-word detector header.
  // Healthy worlds retain every producer output and are not read or written.
  if (dims[23+env] == 0) return;
  float ccd_trace_local[FLEX_CCD_TRACE_SIZE];
  for (int i=0;i<FLEX_CCD_TRACE_SIZE;i++) ccd_trace_local[i]=0.0f;
  narrowphase_status[tid]=0;
  int kind = candidate_meta[10*slot+0];
  int f1 = candidate_meta[10*slot+1];
  int f2 = candidate_meta[10*slot+4];
  int v1 = candidate_meta[10*slot+3];
  int v2 = candidate_meta[10*slot+6];
  int geom = candidate_meta[10*slot+7];
  ccd_trace_local[40]=float(kind);
  ccd_trace_local[41]=(geom>=0 && geom<ngeom)
      ? float(geom_type[geom]) : -1.0f;
  ccd_trace_local[43]=float(kind);
  float3 p=float3(0), q=float3(0), n=float3(0,0,1);
  float3 selection_pos=float3(0.0f);
  FlexDD3 selection_pos_exact=flex_dd3(float3(0.0f));
  bool selection_pos_has_exact=false;
  FlexDD3 contact_pos_exact=flex_dd3(float3(0.0f));
  bool contact_pos_has_exact=false;
  bool source_contact_tested=false;
  float3 t1=float3(0), t2=float3(0);
  float4 w1=float4(0), w2=float4(0);
  float dist=INFINITY;
  bool source_contact_selected=false;
  if (kind == FLEX_PLANE_VERTEX && geom >= 0 && v1 >= 0) {
    ccd_trace_local[43]=1.0f;
    p=flex_world_vertex(flexvert_xpos,env,nvert,v1);
    float3 gp=float3(geom_pos[(env*ngeom+geom)*3+0],
                     geom_pos[(env*ngeom+geom)*3+1],
                     geom_pos[(env*ngeom+geom)*3+2]);
    float4 gq=float4(geom_quat[(env*ngeom+geom)*4+0],
                     geom_quat[(env*ngeom+geom)*4+1],
                     geom_quat[(env*ngeom+geom)*4+2],
                     geom_quat[(env*ngeom+geom)*4+3]);
    float3 local=quat_unrotate(gq,p-gp);
    float3 nl=float3(0,0,1);
    n=quat_rotate(gq,nl);
    dist=dot(local,nl)-flex_radius[f1];
    q=p-n*(0.5f*dist+flex_radius[f1]);
    // mj_collidePlaneFlex stores its contact midpoint in mjtNum and computes
    // it as mju_addScl3(pos, vertex, normal, -dist*0.5-radius). Preserve that
    // source-ordered value for binary64 contact-filter distance ranking; the
    // public row/contact ABI remains float32.
    FlexDD3 vertex_exact=flex_world_vertex_dd(
        flexvert_xpos,flexvert_xpos_low,env,nvert,batch,v1);
    // The packed low/tail planes follow the flex-vertex planes in buffer 29.
    // Geometry positions are produced by FK from the original model doubles;
    // retaining their residuals is necessary for source-order plane distance
    // and midpoint computations (for example, static z=0.2 is not exactly
    // representable by the float32 geom_pos ABI word).
    int vertex_words=batch*nvert*3;
    int geom_words=batch*ngeom*3;
    int geom_base=(env*ngeom+geom)*3;
    int geom_low_base=2*vertex_words+geom_base;
    int geom_tail_base=2*vertex_words+geom_words+geom_base;
    FlexDD3 geom_pos_exact=FlexDD3{
        FlexDD{gp.x,flexvert_xpos_low[geom_low_base],
               flexvert_xpos_low[geom_tail_base]},
        FlexDD{gp.y,flexvert_xpos_low[geom_low_base+1],
               flexvert_xpos_low[geom_tail_base+1]},
        FlexDD{gp.z,flexvert_xpos_low[geom_low_base+2],
               flexvert_xpos_low[geom_tail_base+2]}};
    FlexDD3 normal_exact=flex_dd3(n);
    FlexDD radius_exact=FlexDD{flex_radius[f1],flex_radius_midlow[2*f1],
                               flex_radius_midlow[2*f1+1]};
    FlexDD source_dot=flex_dd3_dot(
        flex_dd3_source_sub(vertex_exact,geom_pos_exact),normal_exact);
    FlexDD source_dist=flex_dd_source_sub(source_dot,radius_exact);
    FlexDD source_contact_limit=flex_dd_source_add(exact_threshold,
                                                    radius_exact);
    bool plane_source_hit=flex_dd_compare(source_dot,source_contact_limit)<=0;
    FlexDD source_scale=flex_dd_source_sub(
        flex_dd_source_mul(flex_dd_neg(source_dist),flex_dd(0.5f)),
        radius_exact);
    selection_pos_exact=FlexDD3{
        flex_dd_source_muladd(normal_exact.x,source_scale,vertex_exact.x),
        flex_dd_source_muladd(normal_exact.y,source_scale,vertex_exact.y),
        flex_dd_source_muladd(normal_exact.z,source_scale,vertex_exact.z)};
    selection_pos=flex_dd3_high(selection_pos_exact);
    q=selection_pos;
    dist=source_dist.hi;
    source_contact_tested=true;
    source_contact_selected=plane_source_hit;
    selection_pos_has_exact=true;
    w1.x=1.0f;
  } else if (kind == FLEX_GEOM_ELEMENT && geom >= 0) {
    int base=slot*4, count=0;
    while (count<4 && candidate_nodes1[base+count]>=0) count++;
    ccd_trace_local[42]=float(count);
    ccd_trace_local[43]=10.0f+float(count);
    if (count>0) {
      float3 center=flex_center(flexvert_xpos,env,nvert,candidate_nodes1,base,count);
      thread float3 supportV[8];
      thread float3 supportW[8];
      for (int i=0;i<count;i++) {
        supportW[i]=flex_world_vertex(flexvert_xpos,env,nvert,
                                      candidate_nodes1[base+i]);
        supportV[i]=flex_world_vertex(flexvert_xpos,env,nvert,
                                      candidate_nodes1[base+i])-center;
      }
      float3 gp=float3(geom_pos[(env*ngeom+geom)*3+0],
                       geom_pos[(env*ngeom+geom)*3+1],
                       geom_pos[(env*ngeom+geom)*3+2]);
      float4 gq=float4(geom_quat[(env*ngeom+geom)*4+0],
                       geom_quat[(env*ngeom+geom)*4+1],
                       geom_quat[(env*ngeom+geom)*4+2],
                       geom_quat[(env*ngeom+geom)*4+3]);
      float3x3 Rg=float3x3(quat_rotate(gq,float3(1,0,0)),
                           quat_rotate(gq,float3(0,1,0)),
                           quat_rotate(gq,float3(0,0,1)));
      float3 size=float3(geom_size[geom*3+0],geom_size[geom*3+1],
                         geom_size[geom*3+2]);
      float margin=candidate_margin_gap[2*slot];
      float gap=candidate_margin_gap[2*slot+1];
      float threshold=margin+gap;
      ContactGeom con[11];
      ContactGeom hfield_contacts[50];
      ContactGeom selected;
      int got=0;
      bool raw_sphere_triangle=false;
      bool raw_sphere_tetra=false;
      bool raw_sphere_epa=false;
      bool raw_capsule_triangle=false;
      bool raw_sphere_capsule=false;
      bool raw_capsule_box=false;
  bool raw_box_triangle=false;
  bool raw_flex_sdf=false;
      bool generic_convex=false;
      if (geom_type[geom] == SDF_SDF) {
        ccd_trace_local[43]=20.0f;
        got=flex_sdf_triangle_contact(
            env,batch,nvert,slot,geom,f1,ngeom,candidate_meta[10*slot+9],
            candidate_meta[10*slot+8]==2,
            candidate_nodes1,flexvert_xpos,flexvert_xpos_low,
            geom_pos,geom_quat,flex_radius,geom_hull,geom_hull_info,dims[5],
            selected,w1,selection_pos,selection_pos_exact,contact_pos_exact);
        selection_pos_has_exact=got>0;
        contact_pos_has_exact=got>0;
        raw_flex_sdf=got>0;
      } else if (geom_type[geom] == CX_HFIELD) {
        ccd_trace_local[43]=21.0f;
        float rbound=flex_radius[f1];
        for (int i=0;i<count;i++) rbound=max(rbound,length(supportV[i])+flex_radius[f1]);
        int nraw=collide_hfield(gp,gq,CX_FLEX,center,float4(1,0,0,0),
            float3(float(count),flex_radius[f1],margin),rbound,
            margin,gap,50,hfield_contacts,geom,0,geom_hull,geom_hull_info,
            supportV,count,flex_radius[f1]);
        int ordinal=candidate_meta[10*slot+9];
        if (ordinal>=0 && ordinal<nraw) {
          selected=hfield_contacts[ordinal];
          got=1;
        }
      } else if (count==2 && geom_type[geom]==CX_SPHERE) {
        ccd_trace_local[43]=22.0f;
        float4 flexq=flex_axis_quat(supportV[0]-supportV[1]);
        float3 flexsize=float3(flex_radius[f1],
            0.5f*length(supportV[1]-supportV[0]),0);
        got=collide_sphere_capsule_raw(gp,gq,size,center,flexq,flexsize,
                                       threshold,con);
        if (got) {
          selected=con[0];
          raw_sphere_capsule=true;
        }
      } else if (count==2 && geom_type[geom]==CX_CAPSULE) {
        ccd_trace_local[43]=23.0f;
        float4 flexq=flex_axis_quat(supportV[0]-supportV[1]);
        float3 flexsize=float3(flex_radius[f1],
            0.5f*length(supportV[1]-supportV[0]),0);
        got=collide_capsule_capsule_raw(gp,gq,size,center,flexq,flexsize,
                                        threshold,con);
        int ordinal=candidate_meta[10*slot+9];
        if (ordinal<0 || ordinal>=got) got=0;
        else selected=con[ordinal];
      } else if (count==2 && geom_type[geom]==CX_BOX) {
        ccd_trace_local[43]=24.0f;
        float4 flexq=flex_axis_quat(supportV[0]-supportV[1]);
        float3 flexsize=float3(flex_radius[f1],
            0.5f*length(supportV[1]-supportV[0]),0);
        got=collide_capsule_box(center,flexq,flexsize,gp,gq,size,
                                threshold,con);
        int ordinal=candidate_meta[10*slot+9];
        if (ordinal<0 || ordinal>=got) got=0;
        else selected=con[ordinal];
        raw_capsule_box=got>0;
      } else if (count==3 && geom_type[geom]==CX_SPHERE) {
        ccd_trace_local[43]=32.0f;
        float4 bary;
        float3 triangle[3]={center+supportV[0],center+supportV[1],
                            center+supportV[2]};
        got=flex_raw_sphere_triangle(
            gp,size.x,triangle[0],triangle[1],triangle[2],flex_radius[f1],
            threshold,selected,bary);
        if (got) {
          w1=bary;
          raw_sphere_triangle=true;
        }
      } else if (count==3 && geom_type[geom]==CX_CAPSULE) {
        ccd_trace_local[43]=33.0f;
        float3 axis=quat_rotate(gq,float3(0,0,1));
        float3 endpoints[2]={gp-axis*size.y,gp+axis*size.y};
        float3 triangle[3]={center+supportV[0],center+supportV[1],
                            center+supportV[2]};
        float4 weights[5];
        got=0;
        for (int endpoint=0;endpoint<2;endpoint++) {
          if (flex_raw_sphere_triangle(
              endpoints[endpoint],size.x,triangle[0],triangle[1],triangle[2],
              flex_radius[f1],threshold,con[got],weights[got])) got++;
        }
        float3 ab=endpoints[1]-endpoints[0];
        float ab2=dot(ab,ab);
        for (int vtx=0;vtx<3;vtx++) {
          float3 diff=triangle[vtx]-endpoints[0];
          float t=dot(diff,ab)/ab2;
          if (t<=1e-15f || t>=1.0f-1e-15f) continue;
          float3 closest=endpoints[0]+ab*t;
          float3 normal=triangle[vtx]-closest;
          float distance=length(normal);
          if (distance>size.x+flex_radius[f1]+threshold) continue;
          if (distance>1e-15f) normal/=distance;
          con[got].dist=distance-size.x-flex_radius[f1];
          con[got].normal=normal;
          con[got].pos=0.5f*(closest+triangle[vtx]
                               +normal*(size.x-flex_radius[f1]));
          con[got].t1=float3(0.0f);
          make_frame(con[got].normal,con[got].t1,con[got].t2);
          weights[got]=float4(0.0f);
          weights[got][vtx]=1.0f;
          got++;
        }
        int ordinal=candidate_meta[10*slot+9];
        if (ordinal<0 || ordinal>=got) got=0;
        else {
          selected=con[ordinal];
          w1=weights[ordinal];
          raw_capsule_triangle=true;
          got=1;
        }
      } else if (count==4 && geom_type[geom]==CX_SPHERE && nativeccd) {
        ccd_trace_local[43]=34.0f;
        // The source-faithful double-float CCD path has its own entry point.
        // Keeping it out of this general detector materially reduces lazy
        // Metal pipeline creation for every ordinary flex candidate.
      } else if (count==3 && geom_type[geom]==CX_BOX) {
        ContactGeom manifold[11];
        float4 weights[11];
        float3 triangle[3]={center+supportV[0],center+supportV[1],
                            center+supportV[2]};
        int nraw=0;
        for (int vtx=0;vtx<3;vtx++) {
          float3 local=quat_unrotate(gq,triangle[vtx]-gp);
          int maxaxis=0;
          float maxval=abs(local.x)-size.x;
          for (int axis=1;axis<3;axis++) {
            float value=abs(local[axis])-size[axis];
            if (value>maxval) { maxval=value; maxaxis=axis; }
          }
          float contact_distance=maxval-flex_radius[f1];
          if (contact_distance>threshold) continue;
          bool inside=true;
          for (int axis=0;axis<3;axis++) {
            if (abs(local[axis])>size[axis]+threshold+flex_radius[f1])
              inside=false;
          }
          if (!inside) continue;
          float3 normal_local=float3(0.0f);
          normal_local[maxaxis]=local[maxaxis]>0.0f ? 1.0f : -1.0f;
          manifold[nraw].normal=quat_rotate(gq,normal_local);
          manifold[nraw].dist=contact_distance;
          manifold[nraw].pos=triangle[vtx]-manifold[nraw].normal*
              (flex_radius[f1]+0.5f*contact_distance);
          manifold[nraw].t1=float3(0.0f);
          make_frame(manifold[nraw].normal,manifold[nraw].t1,
                     manifold[nraw].t2);
          weights[nraw]=float4(0.0f);
          weights[nraw][vtx]=1.0f;
          nraw++;
        }
        for (int corner_id=0;corner_id<8;corner_id++) {
          float3 corner_local=float3(
              (corner_id&1) ? size.x : -size.x,
              (corner_id&2) ? size.y : -size.y,
              (corner_id&4) ? size.z : -size.z);
          float3 corner=gp+quat_rotate(gq,corner_local);
          if (flex_raw_sphere_triangle(corner,0.0f,triangle[0],triangle[1],
              triangle[2],flex_radius[f1],threshold,manifold[nraw],
              weights[nraw])) nraw++;
        }
        int ordinal=candidate_meta[10*slot+9];
        if (ordinal<0 || ordinal>=nraw) got=0;
        else {
          selected=manifold[ordinal];
          w1=weights[ordinal];
          raw_box_triangle=true;
          got=1;
        }
      } else {
        got=cx_single_contact(geom_type[geom],gp,Rg,size,
            CX_FLEX,center,flex_identity(),
            float3(float(count),flex_radius[f1],threshold),
            0.5f*threshold,gp-center,false,con,geom,0,
            geom_hull,geom_hull_info,supportV);
        if (got) { selected=con[0]; generic_convex=true; }
      }
      if (got) {
        bool raw_capsule=(count==2 && geom_type[geom]==CX_CAPSULE);
        dist=raw_sphere_epa || raw_sphere_tetra ? selected.dist+threshold
            : raw_flex_sdf ? selected.dist
            : (geom_type[geom] == CX_HFIELD || raw_capsule || raw_capsule_box
               || raw_sphere_capsule || raw_sphere_triangle
               || raw_capsule_triangle || raw_box_triangle)
              ? selected.dist : generic_convex
                  ? selected.dist+0.5f*threshold : selected.dist+threshold;
        n=selected.normal; q=selected.pos;
        t1=selected.t1; t2=selected.t2;
        if (generic_convex && !raw_sphere_epa)
          q += selected.normal*(0.25f*threshold);
        if (count == 3 && nativeccd && !raw_flex_sdf) {
          float3 corrected;
          bool processed;
          cx_fix_normal_side(geom_type[geom],gp,Rg,size,q,n,
                             corrected,processed);
          if (processed) n=corrected;
        }
        float cdist=generic_convex ? dist
            : (geom_type[geom] == CX_HFIELD || raw_sphere_triangle)
            ? selected.dist+1.5f*margin : selected.dist;
        float3 target=raw_sphere_capsule
            ? q+n*(flex_radius[f1]+0.5f*cdist)
            : raw_capsule ? q+n*(0.5f*cdist)
            : raw_capsule_box ? q-n*(flex_radius[f1]+0.5f*cdist)
            : q+n*(flex_radius[f1]
                   +(generic_convex ? 0.0f : 0.5f*threshold)
                   +0.5f*cdist);
        if (!raw_flex_sdf && !raw_sphere_triangle && !raw_sphere_tetra
            && !raw_capsule_triangle
            && !raw_box_triangle) {
          float4 weights;
          flex_barycentric(target-center,supportV,count,weights);
          w1=weights;
        }
      }
    }
  } else if (kind == FLEX_ELEMENT_PAIR) {
    int base=slot*4, count1=0, count2=0;
    while (count1<4 && candidate_nodes1[base+count1]>=0) count1++;
    while (count2<4 && candidate_nodes2[base+count2]>=0) count2++;
    ccd_trace_local[42]=float(count1*10+count2);
    ccd_trace_local[43]=70.0f;
    if (count1>0 && count2>0) {
      float3 center1=flex_center(flexvert_xpos,env,nvert,candidate_nodes1,base,count1);
      float3 center2=flex_center(flexvert_xpos,env,nvert,candidate_nodes2,base,count2);
      thread float3 supportV[8];
      for (int i=0;i<count1;i++)
        supportV[i]=flex_world_vertex(flexvert_xpos,env,nvert,
                                      candidate_nodes1[base+i])-center1;
      for (int i=0;i<count2;i++)
        supportV[4+i]=flex_world_vertex(flexvert_xpos,env,nvert,
                                       candidate_nodes2[base+i])-center2;
      float threshold=candidate_margin_gap[2*slot]
                     +candidate_margin_gap[2*slot+1];
      ContactGeom con;
      bool raw_capsules=(count1==2 && count2==2);
      int got=0;
      if (raw_capsules) {
        ContactGeom manifold[4];
        FlexDD radius1=FlexDD{flex_radius[f1],
            flex_radius_midlow[2*f1],flex_radius_midlow[2*f1+1]};
        FlexDD radius2=FlexDD{flex_radius[f2],
            flex_radius_midlow[2*f2],flex_radius_midlow[2*f2+1]};
        FlexDD3 world1a=flex_dd3(flex_world_vertex(
            flexvert_xpos,env,nvert,candidate_nodes1[base]));
        FlexDD3 world1b=flex_dd3(flex_world_vertex(
            flexvert_xpos,env,nvert,candidate_nodes1[base+1]));
        FlexDD3 world2a=flex_dd3(flex_world_vertex(
            flexvert_xpos,env,nvert,candidate_nodes2[base]));
        FlexDD3 world2b=flex_dd3(flex_world_vertex(
            flexvert_xpos,env,nvert,candidate_nodes2[base+1]));
        FlexDD3 axis1=flex_dd3_scale(flex_dd3_sub(world1a,world1b),
                                    flex_dd(0.5f));
        FlexDD3 axis2=flex_dd3_scale(flex_dd3_sub(world2a,world2b),
                                    flex_dd(0.5f));
        got=flex_capsule_capsule_raw_dd(
            flex_center_precise(flexvert_xpos,env,nvert,candidate_nodes1,
                                base,count1),axis1,
            flex_center_precise(flexvert_xpos,env,nvert,candidate_nodes2,
                                base,count2),axis2,radius1,radius2,
            exact_threshold,manifold);
        int ordinal=candidate_meta[10*slot+9];
        if (ordinal < 0 || ordinal >= got) got=0;
        else {
          con=manifold[ordinal];
          source_contact_selected=true;
        }
      } else {
        got=cx_single_contact(CX_FLEX,center1,flex_identity(),
            float3(float(count1),flex_radius[f1],threshold),
            CX_FLEX,center2,flex_identity(),
            float3(float(count2),flex_radius2[slot],threshold),
            0.0f,center1-center2,false,&con,0,4,
            geom_hull,geom_hull_info,supportV);
      }
      if (got) {
        dist=raw_capsules ? con.dist : con.dist+threshold;
        n=con.normal; q=con.pos;
        t1=con.t1; t2=con.t2;
        float4 weights1,weights2;
        float3 target1=q-n*(flex_radius[f1]+0.5f*dist);
        float3 target2=q+n*(flex_radius2[slot]+0.5f*dist);
        flex_barycentric(target1-center1,supportV,count1,weights1);
        flex_barycentric(target2-center2,supportV+4,count2,weights2);
        w1=weights1; w2=weights2;
      }
    }
  } else if (kind == FLEX_INTERNAL && v1 >= 0) {
    int base=slot*4, count=0;
    while (count<4 && candidate_nodes2[base+count]>=0) count++;
    if (count>0) {
      float3 point=flex_world_vertex(flexvert_xpos,env,nvert,v1);
      float3 center=flex_center(flexvert_xpos,env,nvert,candidate_nodes2,base,count);
      thread float3 supportV[8];
      supportV[0]=float3(0.0f);
      for (int i=0;i<count;i++)
        supportV[4+i]=flex_world_vertex(flexvert_xpos,env,nvert,
                                        candidate_nodes2[base+i])-center;
      ContactGeom con;
      int got=0;
      float4 weights=float4(0.0f);
      if (count==2) {
        float4 edgeq=flex_axis_quat(supportV[4]-supportV[5]);
        float3 edgesize=float3(flex_radius[f1],
            0.5f*length(supportV[5]-supportV[4]),0.0f);
        got=collide_sphere_capsule_raw(point,float4(1,0,0,0),
            float3(flex_radius[f1],0.0f,0.0f),center,edgeq,edgesize,0.0f,&con);
        if (got) {
          float3 target=con.pos+con.normal*(flex_radius[f1]+0.5f*con.dist);
          flex_barycentric(target-center,supportV+4,count,weights);
        }
      } else if (count==3) {
        got=flex_raw_sphere_triangle(
            point,flex_radius[f1],center+supportV[4],center+supportV[5],
            center+supportV[6],flex_radius[f1],0.0f,con,weights);
        // The pinned convex triangle route computes its face side from the
        // compiled mjtNum vertices. Recover that sign from paired vertex
        // coordinates when the closest point lies on the face interior; a
        // float32 roundtrip can otherwise reverse the contact normal for a
        // nearly coplanar internal feature.
        if (got && min(weights.x,min(weights.y,weights.z))>=0.0f) {
          FlexDD3 a=flex_world_vertex_dd(
              flexvert_xpos,flexvert_xpos_low,env,nvert,batch,
              candidate_nodes2[base]);
          FlexDD3 b=flex_world_vertex_dd(
              flexvert_xpos,flexvert_xpos_low,env,nvert,batch,
              candidate_nodes2[base+1]);
          FlexDD3 c=flex_world_vertex_dd(
              flexvert_xpos,flexvert_xpos_low,env,nvert,batch,
              candidate_nodes2[base+2]);
          FlexDD3 center_exact=flex_world_vertex_dd(
              flexvert_xpos,flexvert_xpos_low,env,nvert,batch,v1);
          FlexDD3 normal_raw=flex_dd3_cross(
              flex_dd3_source_sub(b,a),flex_dd3_source_sub(c,a));
          FlexDD normal_length=flex_dd_sqrt(
              flex_dd3_dot(normal_raw,normal_raw));
          if (flex_dd_compare(normal_length,flex_dd(0.0f))>0) {
            FlexDD3 face_normal=flex_dd3_div(normal_raw,normal_length);
            FlexDD side=flex_dd3_dot(
                flex_dd3_source_sub(center_exact,a),face_normal);
            int side_sign=flex_dd_compare(side,flex_dd(0.0f));
            if (side_sign!=0) {
              con.normal=flex_dd3_high(side_sign<0
                  ? face_normal : flex_dd3_neg(face_normal));
              con.pos=point+con.normal*(flex_radius[f1]
                                        +0.5f*con.dist);
              con.t1=float3(0.0f);
              make_frame(con.normal,con.t1,con.t2);
            }
          }
        }
      } else {
        got=cx_single_contact(CX_FLEX,point,flex_identity(),
            float3(1.0f,flex_radius[f1],0.0f),
            CX_FLEX,center,flex_identity(),
            float3(float(count),flex_radius[f1],0.0f),
            0.0f,point-center,false,&con,0,4,
            geom_hull,geom_hull_info,supportV);
        if (got) {
          float3 target=con.pos+con.normal*(flex_radius[f1]+0.5f*con.dist);
          flex_barycentric(target-center,supportV+4,count,weights);
        }
      }
      if (got) {
        dist=con.dist; n=con.normal; q=con.pos;
        t1=con.t1; t2=con.t2;
        w1.x=1.0f; w2=weights;
      }
    }
  } else if (kind == FLEX_INTERNAL && v2 >= 0) {
    int base=slot*4, count=0;
    while (count<4 && candidate_nodes1[base+count]>=0) count++;
    if (count==3) {
      FlexDD3 point_dd=flex_world_vertex_dd(
          flexvert_xpos,flexvert_xpos_low,env,nvert,batch,v2);
      float3 p0=flex_world_vertex(flexvert_xpos,env,nvert,
                                  candidate_nodes1[base+0]);
      float3 p1=flex_world_vertex(flexvert_xpos,env,nvert,
                                  candidate_nodes1[base+1]);
      float3 p2=flex_world_vertex(flexvert_xpos,env,nvert,
                                  candidate_nodes1[base+2]);
      FlexDD3 p0_dd=flex_world_vertex_dd(
          flexvert_xpos,flexvert_xpos_low,env,nvert,batch,
          candidate_nodes1[base]);
      FlexDD3 p1_dd=flex_world_vertex_dd(
          flexvert_xpos,flexvert_xpos_low,env,nvert,batch,
          candidate_nodes1[base+1]);
      FlexDD3 p2_dd=flex_world_vertex_dd(
          flexvert_xpos,flexvert_xpos_low,env,nvert,batch,
          candidate_nodes1[base+2]);
      FlexDD3 normal_raw=flex_dd3_cross(
          flex_dd3_source_sub(p1_dd,p0_dd),
          flex_dd3_source_sub(p2_dd,p0_dd));
      FlexDD normal_length=flex_dd_sqrt(flex_dd3_dot(normal_raw,normal_raw));
      if (flex_dd_compare(normal_length,flex_dd(0.0f))>0) {
        FlexDD3 normal_dd=flex_dd3_div(normal_raw,normal_length);
        FlexDD dst_dd=flex_dd3_dot(
            flex_dd3_source_sub(point_dd,p0_dd),normal_dd);
        FlexDD radius=FlexDD{flex_radius[f1],flex_radius_midlow[2*f1],
                             flex_radius_midlow[2*f1+1]};
        FlexDD signed_limit=flex_dd_mul(radius,flex_dd(-2.0f));
        if (flex_dd_compare(dst_dd,signed_limit)>0) {
        FlexDD depth_dd=flex_dd_source_sub(
            flex_dd_neg(dst_dd),flex_dd_mul(radius,flex_dd(2.0f)));
        dist=depth_dd.hi+depth_dd.lo+depth_dd.tail;
        FlexDD3 normal_offset=flex_dd3_scale(normal_dd,
            flex_dd_mul(dst_dd,flex_dd(0.5f)));
        n=flex_dd3_high(flex_dd3_neg(normal_dd));
        q=flex_dd3_high(flex_dd3_source_sub(point_dd,normal_offset));
        thread float3 supportV[8];
        float3 center=(p0+p1+p2)/3.0f;
        supportV[0]=p0-center;
        supportV[1]=p1-center;
        supportV[2]=p2-center;
        float3 target=q-n*(flex_radius[f1]+0.5f*dist);
        flex_barycentric(target-center,supportV,3,w1);
        w2.x=1.0f;
        }
      }
    }
  }
  float threshold=candidate_margin_gap[2*slot]+candidate_margin_gap[2*slot+1];
  int hit=isfinite(dist) && (source_contact_tested
      ? source_contact_selected
      : (source_contact_selected || dist <= threshold));
  make_frame(n,t1,t2);
  active[tid]=hit;
  distance[tid]=isfinite(dist) ? dist : 0.0f;
  contact_pos[3*tid+0]=hit ? q.x : 0.0f;
  contact_pos[3*tid+1]=hit ? q.y : 0.0f;
  contact_pos[3*tid+2]=hit ? q.z : 0.0f;
  if (kind != FLEX_GEOM_ELEMENT || geom < 0
      || geom_type[geom] != SDF_SDF) selection_pos=q;
  candidate_selection_pos[3*tid+0]=hit ? selection_pos.x : 0.0f;
  candidate_selection_pos[3*tid+1]=hit ? selection_pos.y : 0.0f;
  candidate_selection_pos[3*tid+2]=hit ? selection_pos.z : 0.0f;
  int selection_base=env*nslot*3+slot*3;
  FlexDD3 contact_value_exact=contact_pos_has_exact
      ? contact_pos_exact
      : (selection_pos_has_exact ? selection_pos_exact : flex_dd3(q));
  for (int axis=0;axis<3;axis++) {
    FlexDD value=axis==0 ? contact_value_exact.x
        : (axis==1 ? contact_value_exact.y : contact_value_exact.z);
    FlexDD contact_residual=flex_dd_source_sub(value,
        flex_dd(axis==0 ? q.x : (axis==1 ? q.y : q.z)));
    contact_pos_low_tail[selection_base+axis]=
        hit ? contact_residual.hi : 0.0f;
    contact_pos_low_tail[selection_base+batch*nslot*3+axis]=
        hit ? contact_residual.lo+contact_residual.tail : 0.0f;
    FlexDD selection_value=axis==0 ? selection_pos_exact.x
        : (axis==1 ? selection_pos_exact.y : selection_pos_exact.z);
    FlexDD selection_residual=flex_dd_source_sub(selection_value,
        flex_dd(axis==0 ? selection_pos.x
            : (axis==1 ? selection_pos.y : selection_pos.z)));
    contact_pos_low_tail[selection_base+2*batch*nslot*3+axis]=
        hit && selection_pos_has_exact ? selection_residual.hi : 0.0f;
    contact_pos_low_tail[selection_base+3*batch*nslot*3+axis]=
        hit && selection_pos_has_exact
            ? selection_residual.lo+selection_residual.tail : 0.0f;
  }
  contact_normal[3*tid+0]=hit ? n.x : 0.0f;
  contact_normal[3*tid+1]=hit ? n.y : 0.0f;
  contact_normal[3*tid+2]=hit ? n.z : 0.0f;
  contact_frame[9*tid+0]=hit ? n.x : 0.0f;
  contact_frame[9*tid+1]=hit ? n.y : 0.0f;
  contact_frame[9*tid+2]=hit ? n.z : 0.0f;
  contact_frame[9*tid+3]=hit ? t1.x : 0.0f;
  contact_frame[9*tid+4]=hit ? t1.y : 0.0f;
  contact_frame[9*tid+5]=hit ? t1.z : 0.0f;
  contact_frame[9*tid+6]=hit ? t2.x : 0.0f;
  contact_frame[9*tid+7]=hit ? t2.y : 0.0f;
      contact_frame[9*tid+8]=hit ? t2.z : 0.0f;
  for (int i=0; i<4; ++i) {
    barycentric1[4*tid+i]=hit ? w1[i] : 0.0f;
    barycentric2[4*tid+i]=hit ? w2[i] : 0.0f;
  }
  float4 jw1=hit ? flex_contact_jac_weights(
      f1,candidate_meta[10*slot+2],v1,f2,v2,q,env,slot,nvert,
      candidate_nodes1,flex_vertadr,flexvert_xpos) : float4(0.0f);
  float4 jw2=hit ? flex_contact_jac_weights(
      f2,candidate_meta[10*slot+5],v2,f1,v1,q,env,slot,nvert,
      candidate_nodes2,flex_vertadr,flexvert_xpos) : float4(0.0f);
  for (int i=0;i<4;i++) {
    jacobian_weights[4*tid+i]=jw1[i];
    jacobian_weights[4*batch*nslot+4*tid+i]=jw2[i];
  }
  if (capture_ccd_trace) {
    for (int i=0;i<FLEX_CCD_TRACE_SIZE;i++)
      ccd_trace[dims[10]*tid+i]=ccd_trace_local[i];
  }
}

// Keep native double-float GJK/EPA in a dedicated lazy pipeline. The general
// detector still handles all non-CCD geometries and contacts; this second
// entry point overwrites only the tetrahedron-vs-sphere candidates that were
// deliberately left inactive by that pass.
kernel void flex_contact_detect_native_ccd(
    device const int* candidate_meta [[buffer(0)]],
    device const int* candidate_nodes1 [[buffer(1)]],
    device float* flexvert_xpos [[buffer(2)]],
    device const float* geom_pos [[buffer(3)]],
    device const float* geom_quat [[buffer(4)]],
    device const float* geom_size [[buffer(5)]],
    device const int* geom_type [[buffer(6)]],
    device const float* flex_radius [[buffer(7)]],
    device const float* candidate_margin_gap [[buffer(8)]],
    device const float* flexvert_xpos_low [[buffer(9)]],
    device const int* geom_hull_info [[buffer(10)]],
    constant int* dims [[buffer(11)]],
    device int* active [[buffer(12)]],
    device float* distance [[buffer(13)]],
    device float* contact_pos [[buffer(14)]],
    device float* contact_normal [[buffer(15)]],
    device float* barycentric1 [[buffer(16)]],
    device float* barycentric2 [[buffer(17)]],
    device float* contact_frame [[buffer(18)]],
    device float* candidate_selection_pos [[buffer(19)]],
    device const int* flex_vertadr [[buffer(20)]],
    device float* jacobian_weights [[buffer(21)]],
    constant float* ccd_tolerance [[buffer(22)]],
    device int* narrowphase_status [[buffer(23)]],
    device float* ccd_trace [[buffer(24)]],
    device float* epa_float_workspace [[buffer(25)]],
    device int* epa_int_workspace [[buffer(26)]],
    device const float* flex_radius_low [[buffer(27)]],
    device const float* geom_size_low [[buffer(28)]],
    device const float* candidate_margin_gap_low [[buffer(29)]],
    constant float* ccd_tolerance_low [[buffer(30)]],
    uint tid [[thread_position_in_grid]]) {
  int batch=dims[0], nslot=dims[1], nvert=dims[2], ngeom=dims[3];
  if (tid>=uint(batch*nslot) || dims[4]==0) return;
  int slot=int(tid)%nslot, env=int(tid)/nslot;
  if (dims[23+env] == 0) return;
  int kind=candidate_meta[10*slot+0];
  int flex_id=candidate_meta[10*slot+1];
  int elem=candidate_meta[10*slot+2];
  int vertex_id=candidate_meta[10*slot+3];
  int other_flex=candidate_meta[10*slot+4];
  int other_vertex=candidate_meta[10*slot+6];
  int geom=candidate_meta[10*slot+7];
  int base=slot*4;
  if (kind!=FLEX_GEOM_ELEMENT || flex_id<0 || geom<0 || geom>=ngeom
      || geom_type[geom]!=CX_SPHERE
      || candidate_nodes1[base]<0 || candidate_nodes1[base+1]<0
      || candidate_nodes1[base+2]<0 || candidate_nodes1[base+3]<0)
    return;
  float3 support_world[4], support_relative[4];
  FlexDD3 support_world_dd[4];
  float3 center=flex_center(flexvert_xpos,env,nvert,candidate_nodes1,base,4);
  for (int i=0;i<4;i++) {
    support_world[i]=flex_world_vertex(flexvert_xpos,env,nvert,
                                       candidate_nodes1[base+i]);
    support_relative[i]=support_world[i]-center;
    int vertex_id=candidate_nodes1[base+i];
    int index=(env*nvert+vertex_id)*3;
      support_world_dd[i]=FlexDD3{
        FlexDD{flexvert_xpos[index],flexvert_xpos_low[index],
               flexvert_xpos_low[batch*nvert*3+index]},
        FlexDD{flexvert_xpos[index+1],flexvert_xpos_low[index+1],
               flexvert_xpos_low[batch*nvert*3+index+1]},
        FlexDD{flexvert_xpos[index+2],flexvert_xpos_low[index+2],
               flexvert_xpos_low[batch*nvert*3+index+2]}};
  }
  float3 sphere_pos=float3(geom_pos[(env*ngeom+geom)*3],
      geom_pos[(env*ngeom+geom)*3+1],geom_pos[(env*ngeom+geom)*3+2]);
  float4 sphere_quat=float4(geom_quat[(env*ngeom+geom)*4],
      geom_quat[(env*ngeom+geom)*4+1],geom_quat[(env*ngeom+geom)*4+2],
      geom_quat[(env*ngeom+geom)*4+3]);
  float3x3 sphere_rotation=float3x3(
      quat_rotate(sphere_quat,float3(1,0,0)),
      quat_rotate(sphere_quat,float3(0,1,0)),
      quat_rotate(sphere_quat,float3(0,0,1)));
  float3 sphere_size=float3(geom_size[geom*3],geom_size[geom*3+1],
                            geom_size[geom*3+2]);
  bool capture_gjk_trace=dims[18]!=0
      && env==dims[19] && slot==dims[20];
  // One slot-targeted GJK trace is appended after the fixed per-slot CCD
  // records in buffer(24); this preserves the 31-buffer ABI and costs no
  // production storage when capture is disabled.
  device float* gjk_trace=capture_gjk_trace
      ? ccd_trace+batch*nslot*dims[10] : ccd_trace;
  FlexDD margin_exact=FlexDD{candidate_margin_gap[2*slot],
      candidate_margin_gap_low[4*slot],candidate_margin_gap_low[4*slot+1]};
  float margin=margin_exact.hi+margin_exact.lo+margin_exact.tail;
  FlexDD gap_exact=FlexDD{candidate_margin_gap[2*slot+1],
      candidate_margin_gap_low[4*slot+2],candidate_margin_gap_low[4*slot+3]};
  FlexDD threshold_exact=flex_dd_source_add(margin_exact,gap_exact);
  float threshold=threshold_exact.hi+threshold_exact.lo+threshold_exact.tail;
  FlexDD sphere_radius_exact=FlexDD{geom_size[geom*3],
      geom_size_low[geom*6],geom_size_low[geom*6+1]};
  FlexDD ccd_tolerance_exact=FlexDD{ccd_tolerance[0],
      ccd_tolerance_low[0],ccd_tolerance_low[1]};
  int float_base=int(tid)*dims[16];
  int int_base=int(tid)*dims[17];
  device CxVertex* epa_vertices_workspace=
      reinterpret_cast<device CxVertex*>(epa_float_workspace+float_base);
  device FlexDDVertex* epa_dd_vertices_workspace=
      reinterpret_cast<device FlexDDVertex*>(epa_float_workspace+float_base
          +dims[11]*12);
  device FlexEpaFace* epa_faces_workspace=
      reinterpret_cast<device FlexEpaFace*>(epa_float_workspace+float_base
          +dims[11]*39);
  device int* epa_face_map_workspace=epa_int_workspace+int_base;
  device int2* epa_horizon_workspace=reinterpret_cast<device int2*>(
      epa_int_workspace+int_base+dims[15]);
  device FlexHorizonFrame* epa_stack_workspace=
      reinterpret_cast<device FlexHorizonFrame*>(epa_int_workspace+int_base
          +dims[15]+dims[13]*2);
  float trace[FLEX_CCD_TRACE_SIZE];
  for (int i=0;i<FLEX_CCD_TRACE_SIZE;i++) trace[i]=0.0f;
  trace[40]=float(kind); trace[41]=float(geom_type[geom]);
  trace[42]=4.0f; trace[43]=34.0f;
  ContactGeom contact;
  int result=flex_sphere_tetra_epa(
      sphere_pos,sphere_rotation,sphere_size,center,
      flex_center_paired_precise(flexvert_xpos,flexvert_xpos_low,env,nvert,batch,
                                 candidate_nodes1,base,4),
      sphere_radius_exact,
      FlexDD{flex_radius[flex_id],flex_radius_low[2*flex_id],
             flex_radius_low[2*flex_id+1]},
      threshold_exact,ccd_tolerance_exact,dims[6],
      support_relative,support_world,support_world_dd,contact,geom,
      flexvert_xpos_low,geom_hull_info,
      trace,gjk_trace,gjk_trace,dims[22],capture_gjk_trace,
      dims[7]!=0 ? ccd_trace+tid*dims[10]+FLEX_CCD_TRACE_SIZE
                 : ccd_trace,
      dims[7]!=0,dims[8],dims[9],epa_vertices_workspace,
      epa_dd_vertices_workspace,epa_faces_workspace,epa_face_map_workspace,
      epa_horizon_workspace,epa_stack_workspace,dims[11],dims[12],dims[13],
      dims[14]);
  float dist=INFINITY;
  float3 q=float3(0), n=float3(0,0,1), t1=float3(0), t2=float3(0);
  float4 w1=float4(0), w2=float4(0);
  float flex_radius_value=flex_radius[flex_id]
      +flex_radius_low[2*flex_id]+flex_radius_low[2*flex_id+1];
  if (result==0 || result==-2) {
    dist=contact.dist+threshold;
    q=contact.pos; n=contact.normal; t1=contact.t1; t2=contact.t2;
    if (result==-2) {
      float3 flex_point=float3(trace[61],trace[62],trace[63])
          +n*(flex_radius_value+0.5f*margin);
      float a,b,c,d;
      cx_tet_closest(support_world[0]-flex_point,
          support_world[1]-flex_point,support_world[2]-flex_point,
          support_world[3]-flex_point,&a,&b,&c,&d);
      w1=float4(a,b,c,d);
    } else {
      float3 target=q+n*(flex_radius_value+0.5f*dist);
      flex_barycentric(target-center,support_relative,4,w1);
    }
  } else if (result>0) {
    narrowphase_status[tid]=result;
  } else if (trace[45]!=0.0f) {
    narrowphase_status[tid]=FLEX_CCD_EPA_UNRESOLVED;
  }
  bool hit=isfinite(dist) && dist<=threshold;
  make_frame(n,t1,t2);
  active[tid]=hit;
  distance[tid]=isfinite(dist) ? dist : 0.0f;
  for (int axis=0;axis<3;axis++) {
    contact_pos[3*tid+axis]=hit ? q[axis] : 0.0f;
    candidate_selection_pos[3*tid+axis]=hit ? q[axis] : 0.0f;
    contact_normal[3*tid+axis]=hit ? n[axis] : 0.0f;
    contact_frame[9*tid+axis]=hit ? n[axis] : 0.0f;
    contact_frame[9*tid+3+axis]=hit ? t1[axis] : 0.0f;
    contact_frame[9*tid+6+axis]=hit ? t2[axis] : 0.0f;
    barycentric1[4*tid+axis]=hit ? w1[axis] : 0.0f;
    barycentric2[4*tid+axis]=hit ? w2[axis] : 0.0f;
  }
  barycentric1[4*tid+3]=hit ? w1.w : 0.0f;
  barycentric2[4*tid+3]=hit ? w2.w : 0.0f;
  float4 jw1=hit ? flex_contact_jac_weights(flex_id,elem,vertex_id,
      other_flex,other_vertex,q,env,slot,nvert,candidate_nodes1,
      flex_vertadr,flexvert_xpos) : float4(0.0f);
  float4 jw2=hit ? flex_contact_jac_weights(other_flex,
      candidate_meta[10*slot+5],other_vertex,flex_id,vertex_id,q,env,slot,nvert,
      candidate_nodes1,flex_vertadr,flexvert_xpos) : float4(0.0f);
  for (int i=0;i<4;i++) {
    jacobian_weights[4*tid+i]=jw1[i];
    jacobian_weights[4*batch*nslot+4*tid+i]=jw2[i];
  }
  if (dims[7]!=0) {
    for (int i=0;i<FLEX_CCD_TRACE_SIZE;i++)
      ccd_trace[dims[10]*tid+i]=trace[i];
  }
}

// Pinned filterFlexContacts: retain every contact when a body-flex group has
// at most mjMAXCONPAIR (50); otherwise choose the deepest first, then repeatedly choose
// the contact farthest from the selected set. Candidate slots and solver row
// spans stay fixed, so this only masks unselected contacts in place.
kernel void flex_contact_select(
    device const int* raw_active [[buffer(0)]],
    device const float* distance [[buffer(1)]],
    device const float* selection_pos [[buffer(2)]],
    device const float* contact_pos [[buffer(3)]],
    device const int* candidate_group [[buffer(4)]],
    device const int* candidate_filterable [[buffer(5)]],
    device const int* candidate_filter_mode [[buffer(6)]],
    device const int* candidate_element [[buffer(7)]],
    device const int* candidate_geom [[buffer(8)]],
    constant int* dims [[buffer(9)]],
    device int* source_active [[buffer(10)]],
    device bool* raw_active_mask [[buffer(11)]],
    device bool* filtered_active [[buffer(12)]],
    device int* permutation [[buffer(13)]],
    device int* selected_position [[buffer(14)]],
    device float* min_distance_words [[buffer(15)]],
    device const float* contact_pos_low_tail [[buffer(16)]],
    uint world [[thread_position_in_grid]]) {
  int batch=dims[0], nslot=dims[1], ngroup=dims[2], maxkeep=dims[3];
  if (world >= uint(batch)) return;
  if (dims[4+int(world)] == 0) return;
  for (int slot=0; slot<nslot; ++slot) {
    int index=int(world)*nslot+slot;
    source_active[index]=raw_active[index];
    raw_active_mask[index]=raw_active[index]!=0;
    filtered_active[index]=candidate_filterable[slot] ? 0 : raw_active[index];
  }

  // Reproduce mjc_FlexSDF's source candidate construction before applying
  // filterFlexContacts to the complete geometry/flex or body/flex group.
  for (int group=0; group<ngroup; ++group) {
    for (int slot=0; slot<nslot; ++slot) {
      if (candidate_filterable[slot] && candidate_group[slot]==group
          && candidate_filter_mode[slot]>0) {
        source_active[int(world)*nslot+slot]=0;
      }
    }
    for (int source_slot=0; source_slot<nslot; ++source_slot) {
      int source_mode=candidate_filter_mode[source_slot];
      if (!candidate_filterable[source_slot]
          || candidate_group[source_slot]!=group || source_mode==0) continue;
      bool seen_source=false;
      for (int prior=0; prior<source_slot; ++prior) {
        if (candidate_filterable[prior]
            && candidate_group[prior]==group
            && candidate_filter_mode[prior]==source_mode
            && candidate_geom[prior]==candidate_geom[source_slot]) {
          seen_source=true;
          break;
        }
      }
      if (seen_source) continue;
      int emitted=0, bvh_candidates=0;
      for (int slot=0; slot<nslot; ++slot) {
        int index=int(world)*nslot+slot;
        int mode=candidate_filter_mode[slot];
        if (!candidate_filterable[slot] || candidate_group[slot]!=group
            || candidate_geom[slot]!=candidate_geom[source_slot]
            || mode!=source_mode
            || !raw_active[index]) continue;
        // Without a flex BVH, mjc_FlexSDF walks elements and Halton seeds in
        // model order, rejecting duplicate points and stopping as soon as its
        // 50-contact precontact buffer fills. This is not the later FPS
        // filter: direct-route identities must be the first unique hits.
        if (mode==3 && emitted>=maxkeep) break;
        if (mode==2) {
          // flexElemCallback emits at most one (deepest Halton) witness per
          // element and retains the first 50 elements in BVH traversal order.
          if (bvh_candidates>=maxkeep) continue;
          bvh_candidates++;
        }
        int words=3*index;
        int low_words=2*batch*nslot*3+words;
        int tail_words=3*batch*nslot*3+words;
        FlexDD3 p=FlexDD3{
            FlexDD{selection_pos[words],contact_pos_low_tail[low_words],
                   contact_pos_low_tail[tail_words]},
            FlexDD{selection_pos[words+1],contact_pos_low_tail[low_words+1],
                   contact_pos_low_tail[tail_words+1]},
            FlexDD{selection_pos[words+2],contact_pos_low_tail[low_words+2],
                   contact_pos_low_tail[tail_words+2]}};
        bool duplicate=false;
        for (int prior=0; prior<slot; ++prior) {
          int other=int(world)*nslot+prior;
          if (!source_active[other] || candidate_group[prior]!=group
              || candidate_geom[prior]!=candidate_geom[slot]
              || candidate_filter_mode[prior]!=mode) continue;
          // Both pinned SDF routes perform addPreContact duplicate checks
          // with an element-local `points` array. The direct route resets it
          // for every element before storing that element's Halton seeds;
          // only the later 50-contact cap is pair-wide. The BVH route also
          // rejects duplicate points when its selected element witnesses are
          // finally added, after one deepest candidate per element.
          if (mode==3 && candidate_element[prior]!=candidate_element[slot])
            continue;
          int other_words=3*other;
          int other_low=2*batch*nslot*3+other_words;
          int other_tail=3*batch*nslot*3+other_words;
          FlexDD3 q=FlexDD3{
              FlexDD{selection_pos[other_words],
                     contact_pos_low_tail[other_low],
                     contact_pos_low_tail[other_tail]},
              FlexDD{selection_pos[other_words+1],
                     contact_pos_low_tail[other_low+1],
                     contact_pos_low_tail[other_tail+1]},
              FlexDD{selection_pos[other_words+2],
                     contact_pos_low_tail[other_low+2],
                     contact_pos_low_tail[other_tail+2]}};
          FlexDD3 delta=flex_dd3_source_sub(p,q);
          FlexDD separation=flex_dd_sqrt(
              flex_dd3_dot(delta,delta));
          if (flex_dd_compare(separation,flex_dd(1.0e-15f))<0) {
            duplicate=true;
            break;
          }
        }
        if (!duplicate) {
          if (mode==1 && emitted>=maxkeep) break;
          source_active[index]=1;
          emitted++;
        }
      }
    }

    // filterFlexContacts runs after the narrowphase batch is complete. It
    // retains all candidates through 50; above that, it selects deepest first
    // and then maximizes distance from the selected contact midpoints.
    int count=0;
    for (int slot=0; slot<nslot; ++slot) {
      int index=int(world)*nslot+slot;
      if (candidate_filterable[slot] && candidate_group[slot]==group
          && source_active[index]) count++;
    }
    if (count<=maxkeep) {
      for (int slot=0; slot<nslot; ++slot) {
        int index=int(world)*nslot+slot;
        if (candidate_filterable[slot] && candidate_group[slot]==group)
          filtered_active[index]=source_active[index];
      }
      continue;
    }
    // The pinned routine mutates the contact array itself. Its selected and
    // min_dist arrays are indexed by the *current contact position* and are
    // not permuted when contacts[nselected] and contacts[best] are swapped.
    // Keep that position-indexed state and mutate a slot permutation so the
    // fixed solver rows remain stable.
    int perm_base=int(world)*nslot;
    int compact_count=0;
    for (int slot=0; slot<nslot; ++slot) {
      int index=perm_base+slot;
      if (!candidate_filterable[slot] || candidate_group[slot]!=group
          || !source_active[index]) continue;
      permutation[perm_base+compact_count]=slot;
      selected_position[perm_base+compact_count]=0;
      // Pinned mjMAXVAL in engine_collision_driver.c is 1e10, not infinity.
      min_distance_words[3*(perm_base+compact_count)+0]=1.0e10f;
      min_distance_words[3*(perm_base+compact_count)+1]=0.0f;
      min_distance_words[3*(perm_base+compact_count)+2]=0.0f;
      compact_count++;
    }
    if (compact_count==0) continue;
    int nselected=0;
    int best=0;
    FlexDD bestdist=flex_dd_neg(
        flex_dd(distance[perm_base+permutation[perm_base]]));
    for (int i=1;i<compact_count;i++) {
      FlexDD candidate_dist=flex_dd_neg(
          flex_dd(distance[perm_base+permutation[perm_base+i]]));
      if (flex_dd_compare(candidate_dist,bestdist)>0) {
        bestdist=candidate_dist;
        best=i;
      }
    }
    while (nselected<maxkeep && best>=0) {
      selected_position[perm_base+best]=1;
      int best_slot=permutation[perm_base+best];
      int best_index=perm_base+best_slot;
      int best_words=int(world)*nslot*3+best_slot*3;
      FlexDD3 bestpos_exact=FlexDD3{
          FlexDD{contact_pos[3*best_index],
                 contact_pos_low_tail[best_words],
                 contact_pos_low_tail[best_words+batch*nslot*3]},
          FlexDD{contact_pos[3*best_index+1],
                 contact_pos_low_tail[best_words+1],
                 contact_pos_low_tail[best_words+batch*nslot*3+1]},
          FlexDD{contact_pos[3*best_index+2],
                 contact_pos_low_tail[best_words+2],
                 contact_pos_low_tail[best_words+batch*nslot*3+2]}};
      int nextbest=-1;
      FlexDD nextbestdist=flex_dd(-1.0f);
      for (int i=0;i<compact_count;i++) {
        if (selected_position[perm_base+i]!=0) continue;
        int slot=permutation[perm_base+i];
        int index=perm_base+slot;
        int position_words=int(world)*nslot*3+slot*3;
        FlexDD3 p_exact=FlexDD3{
            FlexDD{contact_pos[3*index],
                   contact_pos_low_tail[position_words],
                   contact_pos_low_tail[position_words+batch*nslot*3]},
            FlexDD{contact_pos[3*index+1],
                   contact_pos_low_tail[position_words+1],
                   contact_pos_low_tail[position_words+batch*nslot*3+1]},
            FlexDD{contact_pos[3*index+2],
                   contact_pos_low_tail[position_words+2],
                   contact_pos_low_tail[position_words+batch*nslot*3+2]}};
        FlexDD3 delta=flex_dd3_source_sub(p_exact,bestpos_exact);
        // Pinned arm64 filterFlexContacts evaluates `dx*dx + dy*dy + dz*dz`
        // as a rounded `dy*dy`, then FMA(dx*dx, yy), then FMA(dz*dz, xy).
        // Keep the source's binary64 rounding boundary while using the full
        // represented contact midpoint words above.
        FlexDD d2=flex_dd_source_dot3(delta,delta);
        int score_offset=3*(perm_base+i);
        FlexDD min_dist=FlexDD{min_distance_words[score_offset],
            min_distance_words[score_offset+1],
            min_distance_words[score_offset+2]};
        if (flex_dd_compare(d2,min_dist)<0) {
          min_distance_words[score_offset]=d2.hi;
          min_distance_words[score_offset+1]=d2.lo;
          min_distance_words[score_offset+2]=d2.tail;
          min_dist=d2;
        }
        if (flex_dd_compare(min_dist,nextbestdist)>0) {
          nextbestdist=min_dist;
          nextbest=i;
        }
      }
      if (nselected<maxkeep-1) {
        int old=permutation[perm_base+nselected];
        permutation[perm_base+nselected]=permutation[perm_base+best];
        permutation[perm_base+best]=old;
        if (nextbest==nselected) nextbest=best;
      }
      nselected++;
      best=nextbest;
    }
    for (int i=0;i<nselected;i++) {
      int slot=permutation[perm_base+i];
      filtered_active[perm_base+slot]=1;
    }
  }
}

// Fixed-capacity flex-contact wake links. Static lowering deduplicates all
// potential tree pairs; this kernel retains each pair iff any owning slot is
// active. It writes deterministic links and never reads a device count back.
kernel void flex_contact_tree_links(
    device const bool* active [[buffer(0)]],
    device const int* candidate_link_ids [[buffer(1)]],
    device const int* link_tree_pairs [[buffer(2)]],
    constant int* dims [[buffer(3)]],
    device int* links [[buffer(4)]],
    device int* overflow [[buffer(5)]],
    uint world [[thread_position_in_grid]]) {
  int batch=dims[0], nslot=dims[1], max_per_slot=dims[2];
  int nlinks=dims[3], capacity=dims[4];
  if (world >= uint(batch)) return;
  if (dims[5+int(world)] == 0) return;
  int emitted=0, over=0;
  for (int link=0; link<nlinks; ++link) {
    bool live=false;
    for (int slot=0; slot<nslot && !live; ++slot) {
      if (!active[world*nslot+slot]) continue;
      for (int j=0; j<max_per_slot; ++j) {
        if (candidate_link_ids[slot*max_per_slot+j] == link) {
          live=true;
          break;
        }
      }
    }
    if (!live) continue;
    if (emitted < capacity) {
      links[world*capacity+emitted*2+0]=link_tree_pairs[2*link+0];
      links[world*capacity+emitted*2+1]=link_tree_pairs[2*link+1];
      ++emitted;
    } else {
      over=1;
    }
  }
  for (int i=emitted; i<capacity; ++i) {
    links[world*capacity+i*2+0]=-1;
    links[world*capacity+i*2+1]=-1;
  }
  overflow[world]=over;
}

// Pinned mj_diagApprox for admitted flex plane/vertex contacts. The two
// components are source-weighted translational and rotational body weights.
kernel void flex_contact_diag_approx(
    device const float* body_components [[buffer(0)]],
    device const float* friction [[buffer(1)]],
    device const int* condim [[buffer(2)]],
    device const int* cone [[buffer(3)]],
    device const int* row_start [[buffer(4)]],
    device const int* row_span [[buffer(5)]],
    constant int* dims [[buffer(6)]],
    device float* diagA [[buffer(7)]],
    uint index [[thread_position_in_grid]]) {
  int batch=dims[0], nslot=dims[1], nrow=dims[2];
  if (index>=uint(batch*nslot) || nslot==0) return;
  int env=int(index)/nslot, slot=int(index)%nslot;
  if (dims[3+env] == 0) return;
  int first=row_start[slot], span=row_span[slot], dim=condim[slot];
  float tran=body_components[2*slot];
  float rot=body_components[2*slot+1];
  if (cone[slot]==1) {  // mjCONE_ELLIPTIC
    for (int local=0; local<span; ++local) {
      int row=first+local;
      if (row>=0 && row<nrow) diagA[env*nrow+row]=(local<3 ? tran : rot);
    }
  } else if (dim==1) {
    if (first>=0 && first<nrow) diagA[env*nrow+first]=tran;
  } else {               // mjCONE_PYRAMIDAL
    for (int local=0; local<span; ++local) {
      int row=first+local, pair=local/2;
      if (row<0 || row>=nrow) continue;
      float mu=friction[5*slot+pair];
      diagA[env*nrow+row]=tran+mu*mu*(pair<2 ? tran : rot);
    }
  }
}

inline float flex_diag_phi(float x, int basis, int order) {
  if (order==1) return basis==0 ? 1.0f-x : x;
  if (basis==0) return 2.0f*x*x-3.0f*x+1.0f;
  if (basis==1) return 4.0f*(x-x*x);
  return 2.0f*x*x-x;
}

inline float flex_diag_basis_node(
    int node, int flex, int shell, int nx, int ny, int nz,
    int nodeadr, device const int* node_body,
    device const float* body_invweight, int component) {
  int i=node/(ny*nz), rem=node%(ny*nz), j=rem/nz, k=rem%nz;
  if (!shell || i==0 || i==nx-1 || j==0 || j==ny-1 || k==0 || k==nz-1) {
    int body=node_body[nodeadr+node];
    return body_invweight[2*body+component];
  }
  float s=float(i)/float(nx-1), t=float(j)/float(ny-1), u=float(k)/float(nz-1);
  thread int3 index[26];
  thread float factor[26];
  index[0]=int3(0,j,k); factor[0]=1-s;
  index[1]=int3(nx-1,j,k); factor[1]=s;
  index[2]=int3(i,0,k); factor[2]=1-t;
  index[3]=int3(i,ny-1,k); factor[3]=t;
  index[4]=int3(i,j,0); factor[4]=1-u;
  index[5]=int3(i,j,nz-1); factor[5]=u;
  index[6]=int3(i,0,0); factor[6]=-(1-t)*(1-u);
  index[7]=int3(i,0,nz-1); factor[7]=-(1-t)*u;
  index[8]=int3(i,ny-1,0); factor[8]=-t*(1-u);
  index[9]=int3(i,ny-1,nz-1); factor[9]=-t*u;
  index[10]=int3(0,j,0); factor[10]=-(1-s)*(1-u);
  index[11]=int3(0,j,nz-1); factor[11]=-(1-s)*u;
  index[12]=int3(nx-1,j,0); factor[12]=-s*(1-u);
  index[13]=int3(nx-1,j,nz-1); factor[13]=-s*u;
  index[14]=int3(0,0,k); factor[14]=-(1-s)*(1-t);
  index[15]=int3(0,ny-1,k); factor[15]=-(1-s)*t;
  index[16]=int3(nx-1,0,k); factor[16]=-s*(1-t);
  index[17]=int3(nx-1,ny-1,k); factor[17]=-s*t;
  index[18]=int3(0,0,0); factor[18]=(1-s)*(1-t)*(1-u);
  index[19]=int3(0,0,nz-1); factor[19]=(1-s)*(1-t)*u;
  index[20]=int3(0,ny-1,0); factor[20]=(1-s)*t*(1-u);
  index[21]=int3(0,ny-1,nz-1); factor[21]=(1-s)*t*u;
  index[22]=int3(nx-1,0,0); factor[22]=s*(1-t)*(1-u);
  index[23]=int3(nx-1,0,nz-1); factor[23]=s*(1-t)*u;
  index[24]=int3(nx-1,ny-1,0); factor[24]=s*t*(1-u);
  index[25]=int3(nx-1,ny-1,nz-1); factor[25]=s*t*u;
  float result=0.0f;
  for (int q=0;q<26;q++) {
    int boundary=index[q].x*ny*nz+index[q].y*nz+index[q].z;
    int body=node_body[nodeadr+boundary];
    result+=factor[q]*body_invweight[2*body+component];
  }
  return result;
}

inline float flex_diag_side_weight(
    int flex, int elem, int vert, int opposite_vert, int env, int slot,
    int nvert, int nnode, int nflex, int dim,
    device const int* candidate_nodes, device const float* contact_pos,
    device const float* flexvert_xpos, device const float* flex_vert0,
    device const int* flex_vertbody, device const int* flex_interp,
    device const int* flex_vertadr, device const int* flex_nodeadr,
    device const int* flex_cellnum, device const int* flex_dim,
    device const int* flex_nodebody, device const float* body_invweight,
    int component) {
  if (flex<0 || flex>=nflex) return 0.0f;
  int base=slot*4, count=0;
  thread int vert_id[4];
  thread float vweight[4];
  if (vert>=0) {
    vert_id[0]=vert; vweight[0]=1.0f; count=1;
  } else if (elem>=0) {
    int fdim=flex_dim[flex], nper=fdim+1;
    for (int j=0;j<nper;j++) {
      int id=candidate_nodes[base+j];
      if (id<0 || id>=nvert
          || id-flex_vertadr[flex]==opposite_vert) continue;
      float3 p=float3(contact_pos[(env*dim+slot)*3],
                      contact_pos[(env*dim+slot)*3+1],
                      contact_pos[(env*dim+slot)*3+2]);
      float3 x=float3(flexvert_xpos[(env*nvert+id)*3],
                      flexvert_xpos[(env*nvert+id)*3+1],
                      flexvert_xpos[(env*nvert+id)*3+2]);
      vert_id[count]=id;
      vweight[count]=1.0f/max(length(x-p),1.0e-15f);
      count++;
    }
  }
  if (count==0) return 0.0f;
  float total=0.0f;
  for (int j=0;j<count;j++) total+=vweight[j];
  float coord_abs=0.0f;
  float3 coord=float3(0.0f);
  for (int j=0;j<count;j++) {
    vweight[j]/=total;
    float w=abs(vweight[j]);
    coord+=w*float3(flex_vert0[3*vert_id[j]],
                    flex_vert0[3*vert_id[j]+1],flex_vert0[3*vert_id[j]+2]);
    coord_abs+=w;
  }
  if (coord_abs>0.0f) coord/=coord_abs;
  int interp=flex_interp[flex], order=abs(interp);
  if (order==0) {
    float result=0.0f;
    for (int j=0;j<count;j++) {
      int body=flex_vertbody[vert_id[j]];
      result+=vweight[j]*body_invweight[2*body+component];
    }
    return result;
  }
  if (order>2) return 0.0f;
  int cx=flex_cellnum[3*flex], cy=flex_cellnum[3*flex+1],
      cz=flex_cellnum[3*flex+2];
  int cellx=max(0,min(cx-1,int(floor(coord.x*cx))));
  int celly=max(0,min(cy-1,int(floor(coord.y*cy))));
  int cellz=max(0,min(cz-1,int(floor(coord.z*cz))));
  float3 local=clamp(coord*float3(cx,cy,cz)-float3(cellx,celly,cellz),
                     float3(0.0f),float3(1.0f));
  int nx=cx*order+1, ny=cy*order+1, nz=cz*order+1;
  int nodeadr=flex_nodeadr[flex];
  float result=0.0f;
  for (int i=0;i<=order;i++) for (int j=0;j<=order;j++)
    for (int k=0;k<=order;k++) {
      int gi=cellx*order+i, gj=celly*order+j, gk=cellz*order+k;
      float w=flex_diag_phi(local.x,i,order)*flex_diag_phi(local.y,j,order)
             *flex_diag_phi(local.z,k,order);
      if (w<1.0e-5f) continue;
      int node=gi*ny*nz+gj*nz+gk;
      result+=w*flex_diag_basis_node(node,flex,interp<0,nx,ny,nz,nodeadr,
                                     flex_nodebody,body_invweight,component);
    }
  return result;
}

kernel void flex_contact_diag_approx_dynamic(
    device const int* kind [[buffer(0)]],
    device const int* flex1 [[buffer(1)]], device const int* elem1 [[buffer(2)]],
    device const int* vert1 [[buffer(3)]], device const int* flex2 [[buffer(4)]],
    device const int* elem2 [[buffer(5)]], device const int* vert2 [[buffer(6)]],
    device const int* geom [[buffer(7)]],
    device const int* nodes1 [[buffer(8)]], device const int* nodes2 [[buffer(9)]],
    device const float* contact_pos [[buffer(10)]],
    device const float* flexvert_xpos [[buffer(11)]],
    device const float* friction [[buffer(12)]],
    device const int* condim [[buffer(13)]], device const int* cone [[buffer(14)]],
    device const int* row_start [[buffer(15)]], device const int* row_span [[buffer(16)]],
    device const int* geom_body [[buffer(17)]],
    device const int* flex_interp [[buffer(18)]],
    device const int* flex_vertadr [[buffer(19)]],
    device const int* flex_nodeadr [[buffer(20)]],
    device const int* flex_cellnum [[buffer(21)]],
    device const int* flex_dim [[buffer(22)]],
    device const float* flex_vert0 [[buffer(23)]],
    device const int* flex_vertbody [[buffer(24)]],
    device const int* flex_nodebody [[buffer(25)]],
    device const float* body_invweight [[buffer(26)]],
    constant int* dims [[buffer(27)]], device float* diagA [[buffer(28)]],
    uint index [[thread_position_in_grid]]) {
  int batch=dims[0], nslot=dims[1], nrow=dims[2], nvert=dims[3],
      nnode=dims[4], nflex=dims[5], ngeom=dims[6];
  if (index>=uint(batch*nslot) || nslot==0) return;
  int env=int(index)/nslot, slot=int(index)%nslot;
  if (dims[7+env] == 0) return;
  float tran=0.0f, rot=0.0f;
  int g=geom[slot];
  if (g>=0 && g<ngeom) {
    int body=geom_body[g];
    tran+=body_invweight[2*body]; rot+=body_invweight[2*body+1];
  }
  int f=flex1[slot], other=flex2[slot];
  int opposite1=(other>=0 && vert2[slot]>=0)
      ? vert2[slot]-flex_vertadr[other] : -1;
  int opposite2=(f>=0 && vert1[slot]>=0)
      ? vert1[slot]-flex_vertadr[f] : -1;
  tran+=flex_diag_side_weight(f,elem1[slot],vert1[slot],opposite1,
      env,slot,nvert,nnode,nflex, nslot, nodes1,contact_pos,flexvert_xpos,
      flex_vert0,flex_vertbody,flex_interp,flex_vertadr,flex_nodeadr,
      flex_cellnum,flex_dim,flex_nodebody,body_invweight,0);
  rot+=flex_diag_side_weight(f,elem1[slot],vert1[slot],opposite1,
      env,slot,nvert,nnode,nflex,nslot,nodes1,contact_pos,flexvert_xpos,
      flex_vert0,flex_vertbody,flex_interp,flex_vertadr,flex_nodeadr,
      flex_cellnum,flex_dim,flex_nodebody,body_invweight,1);
  tran+=flex_diag_side_weight(other,elem2[slot],vert2[slot],opposite2,
      env,slot,nvert,nnode,nflex,nslot,nodes2,contact_pos,flexvert_xpos,
      flex_vert0,flex_vertbody,flex_interp,flex_vertadr,flex_nodeadr,
      flex_cellnum,flex_dim,flex_nodebody,body_invweight,0);
  rot+=flex_diag_side_weight(other,elem2[slot],vert2[slot],opposite2,
      env,slot,nvert,nnode,nflex,nslot,nodes2,contact_pos,flexvert_xpos,
      flex_vert0,flex_vertbody,flex_interp,flex_vertadr,flex_nodeadr,
      flex_cellnum,flex_dim,flex_nodebody,body_invweight,1);
  int first=row_start[slot], span=row_span[slot], dim=condim[slot];
  int rowbase=env*nrow;
  if (cone[slot]==1) {
    for (int local=0;local<span;local++) {
      int row=first+local;
      if (row>=0 && row<nrow) diagA[rowbase+row]=(local<3 ? tran : rot);
    }
  } else if (dim==1) {
    if (first>=0 && first<nrow) diagA[rowbase+first]=tran;
  } else {
    for (int local=0;local<span;local++) {
      int row=first+local, pair=local/2;
      if (row<0 || row>=nrow) continue;
      float mu=friction[5*slot+pair];
      diagA[rowbase+row]=tran+mu*mu*(pair<2 ? tran : rot);
    }
  }
}

// Interpolate the two descriptor-side point Jacobians at the raw manifold
// witnesses. `geom_point_jac` is supplied by the caller at contact_pos (so a
// moving geom includes its angular lever arm). The canonical relative row is
// side1 - side2; contact-frame orientation is handled by the solver adapter.
kernel void flex_contact_jacobians(
    device const int* candidate_geom [[buffer(0)]],
    device const int* candidate_nodes1 [[buffer(1)]],
    device const int* candidate_nodes2 [[buffer(2)]],
    device const float* jacobian_weight1 [[buffer(3)]],
    device const float* jacobian_weight2 [[buffer(4)]],
    device const float* flexvert_jacobian [[buffer(5)]],
    device const float* geom_point_jacobian [[buffer(6)]],
    constant int* dims [[buffer(7)]],
    device float* side1_jacobian [[buffer(8)]],
    device float* side2_jacobian [[buffer(9)]],
    device float* relative_jacobian [[buffer(10)]],
    uint tid [[thread_position_in_grid]]) {
  int nv=dims[0], nslot=dims[1], nvert=dims[2], batch=dims[3];
  if (tid >= uint(batch*nslot*3*nv)) return;
  int dof=int(tid)%nv;
  int component=(int(tid)/nv)%3;
  int slot=(int(tid)/(3*nv))%nslot;
  int world=int(tid)/(nslot*3*nv);
  if (dims[4+world] == 0) return;
  int row=world*nslot+slot;
  int base=slot*4;
  float j1=0.0f, j2=0.0f;
  for (int i=0;i<4;i++) {
    int node=candidate_nodes1[base+i];
    if (node>=0) {
      int ix=(((world*nvert+node)*3+component)*nv+dof);
      j1 += jacobian_weight1[row*4+i]*flexvert_jacobian[ix];
    }
    node=candidate_nodes2[base+i];
    if (candidate_geom[slot]>=0) {
      int ix=((row*3+component)*nv+dof);
      j2=geom_point_jacobian[ix];
      break;
    }
    if (node>=0) {
      int ix=(((world*nvert+node)*3+component)*nv+dof);
      j2 += jacobian_weight2[row*4+i]*flexvert_jacobian[ix];
    }
  }
  int out=((row*3+component)*nv+dof);
  side1_jacobian[out]=j1;
  side2_jacobian[out]=j2;
  relative_jacobian[out]=j1-j2;
}

// Spatial counterpart used for condim 4/6. The input point Jacobian already
// contains the rigid point lever arm in rows 0..2; rows 3..5 are angular.
kernel void flex_contact_spatial_jacobians(
    device const int* candidate_geom [[buffer(0)]],
    device const int* candidate_nodes1 [[buffer(1)]],
    device const int* candidate_nodes2 [[buffer(2)]],
    device const float* jacobian_weight1 [[buffer(3)]],
    device const float* jacobian_weight2 [[buffer(4)]],
    device const float* flexvert_jacobian [[buffer(5)]],
    device const float* geom_point_jacobian [[buffer(6)]],
    constant int* dims [[buffer(7)]],
    device float* side1_jacobian [[buffer(8)]],
    device float* side2_jacobian [[buffer(9)]],
    device float* relative_jacobian [[buffer(10)]],
    uint tid [[thread_position_in_grid]]) {
  int nv=dims[0], nslot=dims[1], nvert=dims[2], batch=dims[3];
  if (tid >= uint(batch*nslot*6*nv)) return;
  int dof=int(tid)%nv;
  int component=(int(tid)/nv)%6;
  int slot=(int(tid)/(6*nv))%nslot;
  int world=int(tid)/(nslot*6*nv);
  if (dims[4+world] == 0) return;
  int row=world*nslot+slot, base=slot*4;
  float j1=0.0f, j2=0.0f;
  for (int i=0;i<4;i++) {
    int node=candidate_nodes1[base+i];
    if (node>=0) {
      int ix=(((world*nvert+node)*6+component)*nv+dof);
      j1 += jacobian_weight1[row*4+i]*flexvert_jacobian[ix];
    }
    node=candidate_nodes2[base+i];
    if (candidate_geom[slot]>=0) {
      int ix=((row*6+component)*nv+dof);
      j2=geom_point_jacobian[ix];
      break;
    }
    if (node>=0) {
      int ix=(((world*nvert+node)*6+component)*nv+dof);
      j2 += jacobian_weight2[row*4+i]*flexvert_jacobian[ix];
    }
  }
  int out=((row*6+component)*nv+dof);
  side1_jacobian[out]=j1;
  side2_jacobian[out]=j2;
  relative_jacobian[out]=j1-j2;
}

inline float flex_contact_body_jacobian(
    int body, int env, int dof, int component, float3 point,
    int nv, int nbody, device const int* body_root,
    device const int* body_dof_mask, device const float* root_com,
    device const float* cdof) {
  if (body<0 || body>=nbody || !body_dof_mask[body*nv+dof]) return 0.0f;
  int root=body_root[body];
  int base=(env*nv+dof)*6;
  float3 angular=float3(cdof[base],cdof[base+1],cdof[base+2]);
  float3 linear=float3(cdof[base+3],cdof[base+4],cdof[base+5]);
  float3 center=float3(root_com[(env*nbody+root)*3],
                       root_com[(env*nbody+root)*3+1],
                       root_com[(env*nbody+root)*3+2]);
  linear+=cross(angular,point-center);
  if (component<3) return linear[component];
  return angular[component-3];
}

inline float flex_contact_tfi_jacobian(
    int node, float node_weight, int nx, int ny, int nz, int nodeadr,
    int env, int dof, int component, float3 point, int nv, int nbody,
    device const int* node_body, device const int* body_root,
    device const int* body_dof_mask, device const float* root_com,
    device const float* cdof) {
  int i=node/(ny*nz), rem=node%(ny*nz), j=rem/nz, k=rem%nz;
  float s=float(i)/float(nx-1), t=float(j)/float(ny-1), u=float(k)/float(nz-1);
  thread int3 index[26];
  thread float factor[26];
  index[0]=int3(0,j,k); factor[0]=1-s;
  index[1]=int3(nx-1,j,k); factor[1]=s;
  index[2]=int3(i,0,k); factor[2]=1-t;
  index[3]=int3(i,ny-1,k); factor[3]=t;
  index[4]=int3(i,j,0); factor[4]=1-u;
  index[5]=int3(i,j,nz-1); factor[5]=u;
  index[6]=int3(i,0,0); factor[6]=-(1-t)*(1-u);
  index[7]=int3(i,0,nz-1); factor[7]=-(1-t)*u;
  index[8]=int3(i,ny-1,0); factor[8]=-t*(1-u);
  index[9]=int3(i,ny-1,nz-1); factor[9]=-t*u;
  index[10]=int3(0,j,0); factor[10]=-(1-s)*(1-u);
  index[11]=int3(0,j,nz-1); factor[11]=-(1-s)*u;
  index[12]=int3(nx-1,j,0); factor[12]=-s*(1-u);
  index[13]=int3(nx-1,j,nz-1); factor[13]=-s*u;
  index[14]=int3(0,0,k); factor[14]=-(1-s)*(1-t);
  index[15]=int3(0,ny-1,k); factor[15]=-(1-s)*t;
  index[16]=int3(nx-1,0,k); factor[16]=-s*(1-t);
  index[17]=int3(nx-1,ny-1,k); factor[17]=-s*t;
  index[18]=int3(0,0,0); factor[18]=(1-s)*(1-t)*(1-u);
  index[19]=int3(0,0,nz-1); factor[19]=(1-s)*(1-t)*u;
  index[20]=int3(0,ny-1,0); factor[20]=(1-s)*t*(1-u);
  index[21]=int3(0,ny-1,nz-1); factor[21]=(1-s)*t*u;
  index[22]=int3(nx-1,0,0); factor[22]=s*(1-t)*(1-u);
  index[23]=int3(nx-1,0,nz-1); factor[23]=s*(1-t)*u;
  index[24]=int3(nx-1,ny-1,0); factor[24]=s*t*(1-u);
  index[25]=int3(nx-1,ny-1,nz-1); factor[25]=s*t*u;
  float result=0.0f;
  for (int q=0;q<26;q++) {
    int boundary=index[q].x*ny*nz+index[q].y*nz+index[q].z;
    int body=node_body[nodeadr+boundary];
    result+=node_weight*factor[q]*flex_contact_body_jacobian(
        body,env,dof,component,point,nv,nbody,body_root,body_dof_mask,
        root_com,cdof);
  }
  return result;
}

inline float flex_contact_side_jacobian(
    int env, int slot, int side, int dof, int component, float3 point,
    int nv, int nvert, int nflex, int nnode, int nbody,
    device const int* candidate_meta, device const int* candidate_nodes,
    device const float* flexvert_xpos, device const int* flex_vertadr,
    device const int* flex_dim,
    device const int* flex_interp, device const int* flex_cellnum,
    device const float* flex_vert0, device const int* flex_vertbody,
    device const int* flex_nodeadr, device const int* flex_nodebody,
    device const int* geom_body, device const int* body_root,
    device const int* body_dof_mask, device const float* root_com,
    device const float* cdof) {
  int meta=slot*10;
  int flex=candidate_meta[meta+(side==0 ? 1 : 4)];
  int elem=candidate_meta[meta+(side==0 ? 2 : 5)];
  int vert=candidate_meta[meta+(side==0 ? 3 : 6)];
  if (flex<0) {
    int geom=candidate_meta[meta+7];
    if (side==1 && geom>=0)
      return flex_contact_body_jacobian(geom_body[geom],env,dof,component,
          point,nv,nbody,body_root,body_dof_mask,root_com,cdof);
    return 0.0f;
  }
  if (flex>=nflex) return 0.0f;
  int base=slot*4, count=0, nper=flex_dim[flex]+1;
  thread int vertex_id[4];
  thread float vertex_weight[4];
  if (vert>=0) {
    vertex_id[0]=vert; vertex_weight[0]=1.0f; count=1;
  } else if (elem>=0) {
    int other_flex=candidate_meta[meta+(side==0 ? 4 : 1)];
    int other_vert=candidate_meta[meta+(side==0 ? 6 : 3)];
    int opposite=(other_flex>=0 && other_vert>=0)
        ? other_vert-flex_vertadr[other_flex] : -1;
    float sum=0.0f;
    for (int i=0;i<nper;i++) {
      int v=candidate_nodes[base+i];
      if (v<0 || v>=nvert || (opposite>=0
          && v-flex_vertadr[flex]==opposite)) continue;
      // Current positions, rather than rest positions, define mj_elemBodyWeight.
      float3 px=float3(flexvert_xpos[(env*nvert+v)*3],
                       flexvert_xpos[(env*nvert+v)*3+1],
                       flexvert_xpos[(env*nvert+v)*3+2]);
      float weight=1.0f/max(length(px-point),1.0e-15f);
      vertex_id[count]=v; vertex_weight[count]=weight; sum+=weight; count++;
    }
    if (sum>1.0e-15f)
      for (int i=0;i<count;i++) vertex_weight[i]/=sum;
  }
  if (count==0) return 0.0f;
  int interp=flex_interp[flex], order=abs(interp);
  float result=0.0f;
  if (order==0) {
    for (int i=0;i<count;i++) {
      int body=flex_vertbody[vertex_id[i]];
      result+=vertex_weight[i]*flex_contact_body_jacobian(
          body,env,dof,component,point,nv,nbody,body_root,body_dof_mask,
          root_com,cdof);
    }
    return result;
  }
  if (order>2) return 0.0f;
  float3 coord=float3(0.0f);
  for (int i=0;i<count;i++) {
    int v=vertex_id[i];
    coord+=abs(vertex_weight[i])
        *float3(flex_vert0[3*v],flex_vert0[3*v+1],flex_vert0[3*v+2]);
  }
  int cx=flex_cellnum[3*flex], cy=flex_cellnum[3*flex+1],
      cz=flex_cellnum[3*flex+2];
  if (cx<=0 || cy<=0 || cz<=0) return 0.0f;
  int cellx=max(0,min(cx-1,int(floor(coord.x*cx))));
  int celly=max(0,min(cy-1,int(floor(coord.y*cy))));
  int cellz=max(0,min(cz-1,int(floor(coord.z*cz))));
  float3 local=clamp(coord*float3(cx,cy,cz)-float3(cellx,celly,cellz),
                     float3(0.0f),float3(1.0f));
  int nx=cx*order+1, ny=cy*order+1, nz=cz*order+1;
  int nodeadr=flex_nodeadr[flex];
  for (int i=0;i<=order;i++) for (int j=0;j<=order;j++)
    for (int k=0;k<=order;k++) {
      float weight=flex_diag_phi(local.x,i,order)
          *flex_diag_phi(local.y,j,order)*flex_diag_phi(local.z,k,order);
      if (weight<1.0e-5f) continue;
      int gi=cellx*order+i, gj=celly*order+j, gk=cellz*order+k;
      int node=gi*ny*nz+gj*nz+gk;
      int ni=gi, nj=gj, nk=gk;
      bool interior=interp<0 && ni>0 && ni<nx-1 && nj>0 && nj<ny-1
          && nk>0 && nk<nz-1;
      if (interior) {
        result+=flex_contact_tfi_jacobian(node,weight,nx,ny,nz,nodeadr,
            env,dof,component,point,nv,nbody,flex_nodebody,body_root,
            body_dof_mask,root_com,cdof);
      } else {
        int body=flex_nodebody[nodeadr+node];
        result+=weight*flex_contact_body_jacobian(body,env,dof,component,
            point,nv,nbody,body_root,body_dof_mask,root_com,cdof);
      }
    }
  return result;
}

kernel void flex_contact_source_spatial_jacobians(
    device const int* candidate_meta [[buffer(0)]],
    device const int* candidate_nodes1 [[buffer(1)]],
    device const int* candidate_nodes2 [[buffer(2)]],
    device const float* contact_pos [[buffer(3)]],
    device const float* flexvert_xpos [[buffer(4)]],
    device const int* flex_vertadr [[buffer(5)]],
    device const int* flex_dim [[buffer(6)]],
    device const int* flex_interp [[buffer(7)]],
    device const int* flex_cellnum [[buffer(8)]],
    device const float* flex_vert0 [[buffer(9)]],
    device const int* flex_vertbody [[buffer(10)]],
    device const int* flex_nodeadr [[buffer(11)]],
    device const int* flex_nodebody [[buffer(12)]],
    device const int* geom_body [[buffer(13)]],
    device const int* body_root [[buffer(14)]],
    device const int* body_dof_mask [[buffer(15)]],
    device const float* root_com [[buffer(16)]],
    device const float* cdof [[buffer(17)]],
    constant int* dims [[buffer(18)]],
    device float* side1_jacobian [[buffer(19)]],
    device float* side2_jacobian [[buffer(20)]],
    device float* relative_jacobian [[buffer(21)]],
    uint tid [[thread_position_in_grid]]) {
  int batch=dims[0], nslot=dims[1], nv=dims[2], nvert=dims[3],
      nflex=dims[4], nnode=dims[5], nbody=dims[6];
  if (tid>=uint(batch*nslot*6*nv)) return;
  int dof=int(tid)%nv, component=(int(tid)/nv)%6;
  int slot=(int(tid)/(6*nv))%nslot, env=int(tid)/(nslot*6*nv);
  if (dims[7+env] == 0) return;
  int row=env*nslot+slot;
  float3 point=float3(contact_pos[row*3],contact_pos[row*3+1],
                      contact_pos[row*3+2]);
  float side1=flex_contact_side_jacobian(env,slot,0,dof,component,point,
      nv,nvert,nflex,nnode,nbody,candidate_meta,candidate_nodes1,
      flexvert_xpos,flex_vertadr,flex_dim,flex_interp,flex_cellnum,flex_vert0,flex_vertbody,
      flex_nodeadr,flex_nodebody,geom_body,body_root,body_dof_mask,root_com,cdof);
  float side2=flex_contact_side_jacobian(env,slot,1,dof,component,point,
      nv,nvert,nflex,nnode,nbody,candidate_meta,candidate_nodes2,
      flexvert_xpos,flex_vertadr,flex_dim,flex_interp,flex_cellnum,flex_vert0,flex_vertbody,
      flex_nodeadr,flex_nodebody,geom_body,body_root,body_dof_mask,root_com,cdof);
  int out=(row*6+component)*nv+dof;
  side1_jacobian[out]=side1;
  side2_jacobian[out]=side2;
  // Element-pair candidates are stored in source element order, while MuJoCo
  // assembles contact rows as J(contact side 1)-J(contact side 0). Both
  // self-flex and cross-flex pairs therefore reverse the candidate-side
  // difference. Flex/geom candidates are encoded flex-first although the
  // source contact stores geometry on side 0, so those retain flex-geom.
  int kind=candidate_meta[slot*10];
  // Internal candidates keep source feature order too: point/edge for the
  // EV pass and face/opposite-point for tetrahedra. Pinned contact rows use
  // side 1 minus side 0, so both internal and element-pair routes reverse.
  bool source_sides_reversed=(kind==FLEX_ELEMENT_PAIR || kind==FLEX_INTERNAL);
  relative_jacobian[out]=source_sides_reversed ? side2-side1 : side1-side2;
}

// Write source-derived contact rows directly to the coupled solver's packed
// CSR record. This fuses point-J evaluation, contact-frame projection, and
// CSR scatter so sparse profiles never allocate [B,slot,6,nv] staging.
inline void flex_source_ccj_set(device float* record, int row, int dof,
                                float value, int nv) {
  device int* header=reinterpret_cast<device int*>(record);
  if (header[0]!=0x4d4a4353 || header[1]!=1 || header[2]!=1
      || header[3]<0 || header[4]!=nv || header[5]<0
      || header[6]<12 || header[7]<header[6]+header[3]+1
      || header[8]<header[7]+header[5] || header[8]+header[5]>header[9]
      || header[9]<12) {
    atomic_store_explicit(reinterpret_cast<device atomic_int*>(header+10),1,
                          memory_order_relaxed);
    return;
  }
  if (row<0 || row>=header[3] || dof<0 || dof>=nv) {
    if (value!=0.0f)
      atomic_store_explicit(reinterpret_cast<device atomic_int*>(header+10),1,
                            memory_order_relaxed);
    return;
  }
  device const int* rowptr=reinterpret_cast<device const int*>(record)+header[6];
  device const int* columns=reinterpret_cast<device const int*>(record)+header[7];
  int lo=rowptr[row], hi=rowptr[row+1];
  if (lo<0 || hi<lo || hi>header[5]) {
    atomic_store_explicit(reinterpret_cast<device atomic_int*>(header+10),1,
                          memory_order_relaxed);
    return;
  }
  while (lo<hi) {
    int mid=(lo+hi)>>1;
    if (columns[mid]<0 || columns[mid]>=nv) {
      atomic_store_explicit(reinterpret_cast<device atomic_int*>(header+10),1,
                            memory_order_relaxed);
      return;
    }
    if (columns[mid]<dof) lo=mid+1;
    else hi=mid;
  }
  if (lo>=rowptr[row+1] || columns[lo]!=dof) {
    if (value!=0.0f)
      atomic_store_explicit(reinterpret_cast<device atomic_int*>(header+10),1,
                            memory_order_relaxed);
    return;
  }
  record[header[8]+lo]=value;
}

kernel void flex_contact_source_packed_rows(
    device const int* candidate_meta [[buffer(0)]],
    device const int* candidate_nodes1 [[buffer(1)]],
    device const int* candidate_nodes2 [[buffer(2)]],
    device const float* contact_pos [[buffer(3)]],
    device const float* contact_frame [[buffer(4)]],
    device const uchar* contact_active [[buffer(5)]],
    device const float* contact_distance [[buffer(6)]],
    device const float* flexvert_xpos [[buffer(7)]],
    device const int* flex_vertadr [[buffer(8)]],
    device const int* flex_dim [[buffer(9)]],
    device const int* flex_interp [[buffer(10)]],
    device const int* flex_cellnum [[buffer(11)]],
    device const float* flex_vert0 [[buffer(12)]],
    device const int* flex_vertbody [[buffer(13)]],
    device const int* flex_nodeadr [[buffer(14)]],
    device const int* flex_nodebody [[buffer(15)]],
    device const int* geom_body [[buffer(16)]],
    device const int* body_root [[buffer(17)]],
    device const int* body_dof_mask [[buffer(18)]],
    device const float* root_com [[buffer(19)]],
    device const float* cdof [[buffer(20)]],
    device const int* row_start [[buffer(21)]],
    device const int* row_span [[buffer(22)]],
    device const int* condim [[buffer(23)]],
    device const int* cone [[buffer(24)]],
    device const float* friction [[buffer(25)]],
    device const float* margin [[buffer(26)]],
    constant int* dims [[buffer(27)]],
    device float* packed_jacobian [[buffer(28)]],
    uint tid [[thread_position_in_grid]]) {
  int batch=dims[0], nslot=dims[1], nv=dims[2], nvert=dims[3],
      nflex=dims[4], nnode=dims[5], nbody=dims[6], row_offset=dims[7],
      packed_words=dims[8];
  if (nv<=0 || tid>=uint(batch*nslot*nv)) return;
  int dof=int(tid)%nv, slot=(int(tid)/nv)%nslot, env=int(tid)/(nslot*nv);
  if (dims[9+env] == 0) return;
  int bslot=env*nslot+slot;
  float3 point=float3(contact_pos[bslot*3],contact_pos[bslot*3+1],
                      contact_pos[bslot*3+2]);
  float relative[6];
  bool live=contact_active[bslot]!=0 && contact_distance[bslot]<margin[slot];
  if (live) {
    for (int component=0;component<6;component++) {
      float side1=flex_contact_side_jacobian(
          env,slot,0,dof,component,point,nv,nvert,nflex,nnode,nbody,
          candidate_meta,candidate_nodes1,flexvert_xpos,flex_vertadr,flex_dim,
          flex_interp,flex_cellnum,flex_vert0,flex_vertbody,flex_nodeadr,
          flex_nodebody,geom_body,body_root,body_dof_mask,root_com,cdof);
      float side2=flex_contact_side_jacobian(
          env,slot,1,dof,component,point,nv,nvert,nflex,nnode,nbody,
          candidate_meta,candidate_nodes2,flexvert_xpos,flex_vertadr,flex_dim,
          flex_interp,flex_cellnum,flex_vert0,flex_vertbody,flex_nodeadr,
          flex_nodebody,geom_body,body_root,body_dof_mask,root_com,cdof);
      int kind=candidate_meta[slot*10];
      bool source_sides_reversed=(kind==FLEX_ELEMENT_PAIR || kind==FLEX_INTERNAL);
      relative[component]=source_sides_reversed ? side2-side1 : side1-side2;
    }
  } else {
    for (int component=0;component<6;component++) relative[component]=0.0f;
  }
  int dim=condim[slot], cn=cone[slot], first=row_start[slot],
      span=row_span[slot];
  float frame[9];
  for (int i=0;i<9;i++) frame[i]=contact_frame[bslot*9+i];
  device int* first_header=reinterpret_cast<device int*>(packed_jacobian);
  if (first_header[0]!=0x4d4a4353 || first_header[1]!=1
      || first_header[2]!=1 || first_header[4]!=nv
      || first_header[9]<12 || first_header[9]>0x7fffffff/max(batch,1)
      || first_header[9]>packed_words/max(batch,1)
      || first_header[3]<0) {
    atomic_store_explicit(reinterpret_cast<device atomic_int*>(first_header+10),
                          1,memory_order_relaxed);
    return;
  }
  device float* world_record=packed_jacobian+env*first_header[9];
  for (int local=0;local<span;local++) {
    float value=0.0f;
    if (live) {
      if (dim==1) {
        for (int c=0;c<3;c++) value+=frame[c]*relative[c];
      } else if (cn==1) {
        int spatial_base=local<3 ? 0 : 3;
        int frame_axis=local<3 ? local : local-3;
        for (int c=0;c<3;c++)
          value+=frame[frame_axis*3+c]*relative[spatial_base+c];
      } else {
        int pair=local/2, sign=(local%2)==0 ? 1 : -1;
        int axis=pair+1, spatial_base=axis<3 ? 0 : 3;
        int frame_axis=axis<3 ? axis : axis-3;
        float normal=0.0f, tangent=0.0f;
        for (int c=0;c<3;c++) {
          normal+=frame[c]*relative[c];
          tangent+=frame[frame_axis*3+c]*relative[spatial_base+c];
        }
        value=normal+float(sign)*friction[5*slot+pair]*tangent;
      }
    }
    flex_source_ccj_set(world_record,row_offset+first+local,dof,value,nv);
  }
}

// Evaluate the moving rigid side at each compiled flex-contact point using
// MuJoCo's compiled cdof field. cdof is the spatial Jacobian at the root
// subtree COM, so translate its linear half to the contact point before the
// barycentric flex/rigid combination. Geometry on a welded world tree has a
// zero cdof field and naturally produces a zero Jacobian.
kernel void flex_geom_contact_spatial_jacobians(
    device const int* geom_root [[buffer(0)]],
    device const int* geom_dof_mask [[buffer(1)]],
    device const float* contact_pos [[buffer(2)]],
    device const float* root_com [[buffer(3)]],
    device const float* cdof [[buffer(4)]],
    constant int* dims [[buffer(5)]],
    device float* geom_spatial_jacobian [[buffer(6)]],
    uint tid [[thread_position_in_grid]]) {
  int batch=dims[0], nslot=dims[1], nv=dims[2], nbody=dims[3];
  if (tid>=uint(batch*nslot*nv)) return;
  int dof=int(tid)%nv;
  int slot=(int(tid)/nv)%nslot;
  int world=int(tid)/(nslot*nv);
  if (dims[4+world] == 0) return;
  int row=world*nslot+slot;
  int root=geom_root[slot];
  float3 angular=float3(0.0f), linear=float3(0.0f);
  if (root>=0 && root<nbody && geom_dof_mask[slot*nv+dof]) {
    int cbase=(world*nv+dof)*6;
    angular=float3(cdof[cbase],cdof[cbase+1],cdof[cbase+2]);
    linear=float3(cdof[cbase+3],cdof[cbase+4],cdof[cbase+5]);
    float3 point=float3(contact_pos[row*3],contact_pos[row*3+1],
                        contact_pos[row*3+2]);
    float3 center=float3(root_com[(world*nbody+root)*3],
                         root_com[(world*nbody+root)*3+1],
                         root_com[(world*nbody+root)*3+2]);
    linear+=cross(angular,point-center);
  }
  int out=(row*6)*nv+dof;
  geom_spatial_jacobian[out+0*nv]=linear.x;
  geom_spatial_jacobian[out+1*nv]=linear.y;
  geom_spatial_jacobian[out+2*nv]=linear.z;
  geom_spatial_jacobian[out+3*nv]=angular.x;
  geom_spatial_jacobian[out+4*nv]=angular.y;
  geom_spatial_jacobian[out+5*nv]=angular.z;
}
