 // finds minimum using gradient descent
+//
+// Inert per-seed descent trace (diagnostic only): when the
+// MUJOCO_SDF_TRACE environment variable is set to a non-empty value, each
+// seed's gradient-descent trajectory (gradient, line-search trials with
+// alpha/dist/Wolfe operands, terminal criterion) is written to stderr with
+// an MJCSDFTRACE prefix. When unset, no output is produced and no
+// computation changes: every trace statement is a guarded read of existing
+// locals. Production physics never enables this path.
+static int mjc_sdf_trace_on(void) {
+  static int state = -1;
+  if (state < 0) {
+    const char* env = getenv("MUJOCO_SDF_TRACE");
+    state = (env && env[0] != '\0') ? 1 : 0;
+  }
+  return state;
+}
+
 static mjtNum stepGradient(mjtNum x[3], const mjModel* m, const mjSDF* s,
                            const mjData* d, int niter) {
